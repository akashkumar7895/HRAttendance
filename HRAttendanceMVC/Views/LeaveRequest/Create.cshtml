@model LeaveRequest
@{
    ViewData["Title"] = "Create Leave";
    var employees = ViewBag.Employees as IEnumerable<Employee> ?? Enumerable.Empty<Employee>();
    var leaveTypes = ViewBag.LeaveTypes as IEnumerable<LeaveType> ?? Enumerable.Empty<LeaveType>();
}
<h2>Create Leave Request</h2>
<form asp-action="Create" method="post" class="card p-4 mt-3">
    @Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="EmployeeId">Employee</label>
        <select asp-for="EmployeeId" class="form-select">
            <option value="">-- Select Employee --</option>
            @foreach (var e in employees)
            {
                <option value="@e.Id">@e.EmployeeCode - @e.FullName</option>
            }
        </select>
        <span asp-validation-for="EmployeeId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="LeaveTypeId">Leave Type</label>
        <select asp-for="LeaveTypeId" class="form-select">
            <option value="">-- Select Leave Type --</option>
            @foreach (var t in leaveTypes)
            {
                <option value="@t.Id">@t.Name (@t.TotalDays days)</option>
            }
        </select>
        <span asp-validation-for="LeaveTypeId" class="text-danger"></span>
    </div>
    <div class="row">
        <div class="col-md-6 mb-3"><label asp-for="FromDate"></label><input asp-for="FromDate" type="date" class="form-control" /></div>
        <div class="col-md-6 mb-3"><label asp-for="ToDate"></label><input asp-for="ToDate" type="date" class="form-control" /></div>
    </div>
    <div class="mb-3"><label asp-for="Reason"></label><textarea asp-for="Reason" class="form-control"></textarea></div>
    <button class="btn btn-warning mb-2">Submit Leave</button> <a class="btn btn-secondary" asp-action="Index">Back</a>
</form>
@section Scripts {
<partial name="_ValidationScriptsPartial" />
}
