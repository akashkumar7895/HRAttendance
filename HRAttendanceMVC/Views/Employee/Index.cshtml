@model IEnumerable<Employee>
@{
    ViewData["Title"] = "Employees";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Employees</h2>
    <div>
        <a class="btn btn-secondary" asp-controller="Dashboard" asp-action="Index">Back</a>
        <a class="btn btn-primary" asp-action="Create">+ Add Employee</a>
    </div>
</div>

<div class="table-responsive card">
    <table class="table table-hover mb-0">
        <thead><tr><th>Code</th><th>Name</th><th>Email</th><th>Department</th><th>Designation</th><th>Joining Date</th><th>Status</th><th>Action</th></tr></thead>
        <tbody>
            @foreach (var x in Model)
            {
                <tr>
                    <td>@x.EmployeeCode</td>
                    <td>@x.FullName</td>
                    <td>@x.Email</td>
                    <td>@x.Department</td>
                    <td>@x.Designation</td>
                    <td>@x.JoiningDate.ToString("dd-MM-yyyy")</td>
                    <td>@(x.IsActive ? "Active" : "Inactive")</td>
                    <td>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@x.Id">Edit</a>
                        <form asp-action="Delete" asp-route-id="@x.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this employee?');">
                            @Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
