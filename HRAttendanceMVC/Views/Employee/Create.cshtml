@model Employee
@{
    ViewData["Title"] = "Add Employee";
}
<h2>Add Employee</h2>
<form asp-action="Create" method="post" class="card p-4 mt-3">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row">
        <div class="col-md-6 mb-3"><label asp-for="EmployeeCode"></label><input asp-for="EmployeeCode" class="form-control" /><span asp-validation-for="EmployeeCode" class="text-danger"></span></div>
        <div class="col-md-6 mb-3"><label asp-for="Email"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger"></span></div>
        <div class="col-md-6 mb-3"><label asp-for="FirstName"></label><input asp-for="FirstName" class="form-control" /><span asp-validation-for="FirstName" class="text-danger"></span></div>
        <div class="col-md-6 mb-3"><label asp-for="LastName"></label><input asp-for="LastName" class="form-control" /><span asp-validation-for="LastName" class="text-danger"></span></div>
        <div class="col-md-6 mb-3"><label asp-for="Phone"></label><input asp-for="Phone" class="form-control" /></div>
        <div class="col-md-6 mb-3"><label asp-for="Department"></label><input asp-for="Department" class="form-control" /><span asp-validation-for="Department" class="text-danger"></span></div>
        <div class="col-md-6 mb-3"><label asp-for="Designation"></label><input asp-for="Designation" class="form-control" /><span asp-validation-for="Designation" class="text-danger"></span></div>
        <div class="col-md-6 mb-3"><label asp-for="JoiningDate"></label><input asp-for="JoiningDate" type="date" class="form-control" /><span asp-validation-for="JoiningDate" class="text-danger"></span></div>
        <div class="col-md-6 mb-3 form-check ms-2"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div>
    </div>
    <button class="btn btn-primary mb-2">Save</button> <a class="btn btn-secondary" asp-action="Index">Back</a>
</form>
@section Scripts {
<partial name="_ValidationScriptsPartial" />
 }
