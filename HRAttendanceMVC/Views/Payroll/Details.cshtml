@model HRAttendanceMVC.Domain.Enities.Payroll
@using HRAttendanceMVC.Helpers

@{
    ViewData["Title"] = $"Payslip - {Model.Employee?.FullName} ({Model.MonthName})";
    decimal gross = Model.BasicSalary + Model.HRA + Model.OtherAllowances;
    decimal net = gross - Model.Deductions;
    string netInWords = NumberToWordsHelper.ToIndianRupeesWords(net);
    string payslipNo = $"PS-{Model.Year}{Model.Month:D2}-{Model.Id:D4}";
    string safeFilename = $"Payslip_{Model.Employee?.EmployeeCode}_{Model.MonthName.Replace(" ", "_")}.pdf";
}

<!-- Action Buttons Bar (Hidden when Printing) -->
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2 d-print-none">
    <div>
        <a class="btn btn-outline-secondary btn-sm" asp-action="Index">
            <i class="bi bi-arrow-left me-1"></i>Back to Payroll List
        </a>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <button type="button" class="btn btn-danger fw-semibold shadow-sm" id="btnDownloadPdf" onclick="downloadPayslipPdf()">
            <i class="bi bi-file-earmark-pdf-fill me-1"></i>Download PDF
        </button>
        <button type="button" class="btn btn-outline-dark fw-semibold shadow-sm" onclick="window.print()">
            <i class="bi bi-printer-fill me-1"></i>Print Slip
        </button>
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">
            <i class="bi bi-pencil me-1"></i>Edit
        </a>
    </div>
</div>

<!-- Payslip Main Container -->
<div class="row justify-content-center">
    <div class="col-lg-10 col-xl-9">
        <div class="card border shadow-sm p-4 p-md-5 bg-white" id="payslip">

            <!-- Company Header -->
            <div class="border-bottom pb-3 mb-4">
                <div class="row align-items-center">
                    <div class="col-sm-8 text-center text-sm-start mb-3 mb-sm-0">
                        <div class="d-flex align-items-center justify-content-center justify-content-sm-start gap-2 mb-1">
                            <div class="bg-success text-white rounded p-2 d-inline-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                                <i class="bi bi-buildings fs-5"></i>
                            </div>
                            <h3 class="mb-0 fw-bold text-success tracking-wide">HR ATTENDANCE &amp; HRMS</h3>
                        </div>
                        <p class="text-muted small mb-0 ps-sm-1">
                            Human Resource Management &amp; Employee Payroll Services
                        </p>
                    </div>
                    <div class="col-sm-4 text-center text-sm-end">
                        <span class="badge bg-success bg-opacity-10 text-success border border-success px-3 py-2 fs-6 mb-1 d-inline-block">
                            SALARY PAYSLIP
                        </span>
                        <div class="small text-muted"><strong>Slip No:</strong> @payslipNo</div>
                        <div class="small text-muted"><strong>Pay Period:</strong> @Model.MonthName</div>
                    </div>
                </div>
            </div>

            <!-- Employee & Pay Metadata Box -->
            <div class="bg-light rounded border p-3 mb-4">
                <div class="row g-2 small">
                    <div class="col-md-6 border-end-md">
                        <table class="table table-sm table-borderless mb-0">
                            <tr>
                                <td class="text-muted" style="width: 140px;">Employee Name:</td>
                                <td class="fw-bold text-dark">@Model.Employee?.FullName</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Employee Code:</td>
                                <td class="fw-semibold">@Model.Employee?.EmployeeCode</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Department:</td>
                                <td>@(string.IsNullOrWhiteSpace(Model.Employee?.Department) ? "-" : Model.Employee?.Department)</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Designation:</td>
                                <td>@(string.IsNullOrWhiteSpace(Model.Employee?.Designation) ? "-" : Model.Employee?.Designation)</td>
                            </tr>
                        </table>
                    </div>
                    <div class="col-md-6 ps-md-3">
                        <table class="table table-sm table-borderless mb-0">
                            <tr>
                                <td class="text-muted" style="width: 140px;">Pay Month / Year:</td>
                                <td class="fw-semibold text-dark">@Model.MonthName</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Joining Date:</td>
                                <td>@Model.Employee?.JoiningDate.ToString("dd-MMM-yyyy")</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Payment Status:</td>
                                <td>
                                    @if (Model.Status == "Paid")
                                    {
                                        <span class="badge bg-success px-2 py-1"><i class="bi bi-check-circle me-1"></i>Paid</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark px-2 py-1"><i class="bi bi-clock me-1"></i>Pending</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <td class="text-muted">Generated Date:</td>
                                <td>@Model.CreatedAt.ToString("dd-MMM-yyyy")</td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Earnings & Deductions Comparison Table -->
            <div class="table-responsive mb-4">
                <table class="table table-bordered align-middle mb-0">
                    <thead class="table-light text-center small text-uppercase">
                        <tr>
                            <th colspan="2" class="text-success border-end w-50 py-2">
                                <i class="bi bi-plus-circle me-1"></i>Earnings (Gross Components)
                            </th>
                            <th colspan="2" class="text-danger w-50 py-2">
                                <i class="bi bi-dash-circle me-1"></i>Deductions
                            </th>
                        </tr>
                        <tr class="small text-muted bg-white">
                            <th class="text-start">Description</th>
                            <th class="text-end border-end" style="width: 140px;">Amount (₹)</th>
                            <th class="text-start">Description</th>
                            <th class="text-end" style="width: 140px;">Amount (₹)</th>
                        </tr>
                    </thead>
                    <tbody class="small">
                        <tr>
                            <td>Basic Salary</td>
                            <td class="text-end border-end font-monospace">₹@Model.BasicSalary.ToString("N2")</td>
                            <td>Deductions / Loss of Pay (LOP)</td>
                            <td class="text-end font-monospace text-danger">-₹@Model.Deductions.ToString("N2")</td>
                        </tr>
                        <tr>
                            <td>House Rent Allowance (HRA)</td>
                            <td class="text-end border-end font-monospace">₹@Model.HRA.ToString("N2")</td>
                            <td class="text-muted">Other Deductions / Tax</td>
                            <td class="text-end font-monospace text-muted">₹0.00</td>
                        </tr>
                        <tr>
                            <td>Other Allowances</td>
                            <td class="text-end border-end font-monospace">₹@Model.OtherAllowances.ToString("N2")</td>
                            <td></td>
                            <td></td>
                        </tr>
                    </tbody>
                    <tfoot class="fw-bold small">
                        <tr class="table-light">
                            <td class="text-success">Total Earnings (Gross)</td>
                            <td class="text-end text-success border-end font-monospace">₹@gross.ToString("N2")</td>
                            <td class="text-danger">Total Deductions</td>
                            <td class="text-end text-danger font-monospace">-₹@Model.Deductions.ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <!-- Net Salary Summary Banner -->
            <div class="card bg-success bg-opacity-10 border-success mb-4">
                <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div>
                        <div class="small text-uppercase fw-bold text-success tracking-wide mb-1">
                            <i class="bi bi-wallet2 me-1"></i>Net Take-Home Salary
                        </div>
                        <div class="small text-muted">
                            <strong>Amount in Words:</strong> <span class="text-dark fst-italic">@netInWords</span>
                        </div>
                    </div>
                    <div class="text-sm-end">
                        <div class="fs-2 fw-bold text-success font-monospace mb-0">
                            ₹@net.ToString("N2")
                        </div>
                    </div>
                </div>
            </div>

            <!-- Remarks Note (if present) -->
            @if (!string.IsNullOrWhiteSpace(Model.Remarks))
            {
                <div class="alert alert-secondary py-2 px-3 small mb-4">
                    <strong><i class="bi bi-info-circle me-1"></i>Notes / Remarks:</strong>
                    <span class="text-muted ms-1">@Model.Remarks</span>
                </div>
            }

            <!-- Signatures Section -->
            <div class="row pt-4 mt-2 text-center small text-muted">
                <div class="col-6">
                    <div class="border-top pt-2 mx-auto" style="max-width: 200px;">
                        <strong>Employee Signature</strong>
                    </div>
                </div>
                <div class="col-6">
                    <div class="border-top pt-2 mx-auto" style="max-width: 220px;">
                        <span class="badge bg-success bg-opacity-10 text-success border border-success mb-1 py-1 px-2 d-inline-block">
                            <i class="bi bi-shield-check me-1"></i>Digitally Verified
                        </span>
                        <div><strong>Authorized Signatory</strong></div>
                        <small class="text-muted">HR &amp; Accounts Department</small>
                    </div>
                </div>
            </div>

            <!-- Footer Disclaimer -->
            <div class="text-center text-muted small mt-4 pt-3 border-top" style="font-size: 0.78rem;">
                <p class="mb-1">
                    This is a system-generated official salary slip. It does not require a physical signature.
                </p>
                <p class="mb-0 text-muted opacity-75">
                    Generated via HR Attendance Management System on @DateTime.Now.ToString("dd-MMM-yyyy hh:mm tt")
                </p>
            </div>

        </div>
    </div>
</div>

<!-- Print Styles -->
<style>
@@media print {
    /* Hide everything except the payslip card */
    body {
        margin: 0 !important;
        padding: 0 !important;
        background: #ffffff !important;
    }
    nav, .navbar, footer, .d-print-none, .btn, .alert-dismissible {
        display: none !important;
    }
    .container, .container-fluid {
        width: 100% !important;
        max-width: 100% !important;
        padding: 0 !important;
        margin: 0 !important;
    }
    .card {
        border: none !important;
        box-shadow: none !important;
        padding: 0 !important;
    }
    #payslip {
        width: 100% !important;
        max-width: 100% !important;
        border: none !important;
        box-shadow: none !important;
        margin: 0 !important;
        padding: 10mm !important;
    }
    @@page {
        size: A4 portrait;
        margin: 5mm;
    }
}

/* Screen styling for payslip container */
#payslip {
    background: #ffffff;
    border-radius: 8px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.06);
}
.tracking-wide {
    letter-spacing: 0.5px;
}
</style>

@section Scripts {
<script src="~/js/html2pdf.bundle.min.js"></script>
<script>
    function downloadPayslipPdf() {
        const btn = document.getElementById('btnDownloadPdf');
        const originalHtml = btn.innerHTML;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span>Generating PDF...';
        btn.disabled = true;

        const element = document.getElementById('payslip');

        const opt = {
            margin:       [8, 8, 8, 8],
            filename:     '@safeFilename',
            image:        { type: 'jpeg', quality: 0.98 },
            html2canvas:  { scale: 2, useCORS: true, logging: false },
            jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' }
        };

        html2pdf()
            .set(opt)
            .from(element)
            .save()
            .then(() => {
                btn.innerHTML = '<i class="bi bi-check2 me-1"></i>Downloaded!';
                setTimeout(() => {
                    btn.innerHTML = originalHtml;
                    btn.disabled = false;
                }, 2000);
            })
            .catch(err => {
                console.error('PDF generation error:', err);
                btn.innerHTML = originalHtml;
                btn.disabled = false;
                alert('Could not generate PDF. You can also use the "Print Slip" button to save as PDF.');
            });
    }

    // Auto-download if ?download=true was in the URL
    @if (ViewBag.AutoDownload == true)
    {
        <text>
        window.addEventListener('DOMContentLoaded', function() {
            setTimeout(downloadPayslipPdf, 600);
        });
        </text>
    }
</script>
}
