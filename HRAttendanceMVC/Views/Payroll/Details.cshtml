@model HRAttendanceMVC.Domain.Enities.Payroll

@{
    ViewData["Title"] = "Payroll Slip";
    decimal net = Model.BasicSalary + Model.HRA + Model.OtherAllowances - Model.Deductions;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0"><i class="bi bi-receipt me-2 text-info"></i>Payroll Slip</h2>
        <small class="text-muted">@(new DateTime(Model.Year, Model.Month, 1).ToString("MMMM yyyy"))</small>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-secondary" onclick="window.print()">
            <i class="bi bi-printer me-1"></i>Print
        </button>
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">
            <i class="bi bi-pencil me-1"></i>Edit
        </a>
        <a class="btn btn-outline-dark" asp-action="Index">
            <i class="bi bi-arrow-left me-1"></i>Back
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-12">
        <div class="card shadow border-0" id="payslip">
            <!-- Header -->
            <div class="card-header bg-success text-white py-4 text-center">
                <h3 class="mb-0 fw-bold">HR Attendance</h3>
                <p class="mb-0 opacity-75">Salary Slip for @(new DateTime(Model.Year, Model.Month, 1).ToString("MMMM yyyy"))</p>
            </div>

            <div class="card-body p-4">
                <!-- Employee Info -->
                <div class="row mb-4">
                    <div class="col-md-6">
                        <h6 class="text-muted text-uppercase small mb-2">Employee Details</h6>
                        <table class="table table-sm table-borderless mb-0">
                            <tr>
                                <td class="text-muted">Name</td>
                                <td class="fw-semibold">@Model.Employee?.FullName</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Employee Code</td>
                                <td>@Model.Employee?.EmployeeCode</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Department</td>
                                <td>@Model.Employee?.Department</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Designation</td>
                                <td>@Model.Employee?.Designation</td>
                            </tr>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <h6 class="text-muted text-uppercase small mb-2">Payroll Details</h6>
                        <table class="table table-sm table-borderless mb-0">
                            <tr>
                                <td class="text-muted">Month / Year</td>
                                <td class="fw-semibold">@(new DateTime(Model.Year, Model.Month, 1).ToString("MMMM yyyy"))</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Status</td>
                                <td>
                                    @if (Model.Status == "Paid")
                                    {
                                        <span class="badge bg-success">Paid</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <td class="text-muted">Generated</td>
                                <td>@Model.CreatedAt.ToString("dd-MM-yyyy")</td>
                            </tr>
                        </table>
                    </div>
                </div>

                <hr />

                <!-- Earnings & Deductions Table -->
                <div class="row">
                    <div class="col-md-6">
                        <h6 class="text-success mb-3"><i class="bi bi-plus-circle me-1"></i>Earnings</h6>
                        <table class="table table-sm">
                            <tbody>
                                <tr>
                                    <td>Basic Salary</td>
                                    <td class="text-end fw-semibold">₹@Model.BasicSalary.ToString("N2")</td>
                                </tr>
                                <tr>
                                    <td>HRA</td>
                                    <td class="text-end">₹@Model.HRA.ToString("N2")</td>
                                </tr>
                                <tr>
                                    <td>Other Allowances</td>
                                    <td class="text-end">₹@Model.OtherAllowances.ToString("N2")</td>
                                </tr>
                                <tr class="table-success">
                                    <td class="fw-bold">Total Earnings</td>
                                    <td class="text-end fw-bold">₹@((Model.BasicSalary + Model.HRA + Model.OtherAllowances).ToString("N2"))</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <h6 class="text-danger mb-3"><i class="bi bi-dash-circle me-1"></i>Deductions</h6>
                        <table class="table table-sm">
                            <tbody>
                                <tr>
                                    <td>Total Deductions</td>
                                    <td class="text-end text-danger">-₹@Model.Deductions.ToString("N2")</td>
                                </tr>
                                <tr class="table-danger">
                                    <td class="fw-bold">Total Deductions</td>
                                    <td class="text-end fw-bold text-danger">-₹@Model.Deductions.ToString("N2")</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <hr />

                <!-- Net Salary -->
                <div class="alert alert-success d-flex justify-content-between align-items-center py-3">
                    <h5 class="mb-0"><i class="bi bi-cash-stack me-2"></i>Net Salary</h5>
                    <h4 class="mb-0 fw-bold">₹@net.ToString("N2")</h4>
                </div>

                @if (!string.IsNullOrEmpty(Model.Remarks))
                {
                    <div class="mt-3">
                        <strong>Remarks:</strong>
                        <p class="text-muted mb-0">@Model.Remarks</p>
                    </div>
                }

                <!-- Footer note -->
                <div class="text-center text-muted small mt-4 pt-3 border-top">
                    This is a computer-generated payroll slip and does not require a signature.
                </div>
            </div>
        </div>
    </div>
</div>

<style>
@@media print {
    nav, .d-flex.justify-content-between, footer { display: none !important; }
    .card { box-shadow: none !important; }
}
</style>
