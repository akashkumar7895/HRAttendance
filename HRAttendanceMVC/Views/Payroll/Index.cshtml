@model IEnumerable<HRAttendanceMVC.Domain.Enities.Payroll>
@using HRAttendanceMVC.Domain.Enities

@{
    ViewData["Title"] = "Payroll";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0">
            <i class="bi bi-cash-coin me-2 text-success"></i>Payroll Management
        </h2>
        <small class="text-muted">Manage employee salary records</small>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-controller="Dashboard" asp-action="Index">
            <i class="bi bi-house me-1"></i>Dashboard
        </a>
        <a class="btn btn-success" asp-action="Create">
            <i class="bi bi-plus-circle me-1"></i>Add Payroll
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info d-flex align-items-center gap-2">
        <i class="bi bi-info-circle-fill fs-5"></i>
        <span>No payroll records found. Click <strong>Add Payroll</strong> to create one.</span>
    </div>
}
else
{
    <!-- Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-center py-3">
                <div class="text-success fs-3 fw-bold">@Model.Count()</div>
                <div class="text-muted small">Total Records</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-center py-3">
                <div class="text-primary fs-3 fw-bold">@Model.Count(p => p.Status == "Paid")</div>
                <div class="text-muted small">Paid</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-center py-3">
                <div class="text-warning fs-3 fw-bold">@Model.Count(p => p.Status == "Pending")</div>
                <div class="text-muted small">Pending</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-center py-3">
                <div class="text-success fs-3 fw-bold">
                    ₹@Model.Sum(p => p.BasicSalary + p.HRA + p.OtherAllowances - p.Deductions).ToString("N0")
                </div>
                <div class="text-muted small">Total Net Salary</div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0"><i class="bi bi-table me-2 text-success"></i>Payroll Records</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Employee</th>
                        <th>Month / Year</th>
                        <th class="text-end">Basic</th>
                        <th class="text-end">HRA</th>
                        <th class="text-end">Allowances</th>
                        <th class="text-end">Deductions</th>
                        <th class="text-end fw-bold">Net Salary</th>
                        <th class="text-center">Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int i = 1; }
                    @foreach (var p in Model)
                    {
                        decimal net = p.BasicSalary + p.HRA + p.OtherAllowances - p.Deductions;
                        <tr>
                            <td class="text-muted">@(i++)</td>
                            <td>
                                <div class="fw-semibold">@p.Employee?.FullName</div>
                                <small class="text-muted">@p.Employee?.EmployeeCode</small>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @(new DateTime(p.Year, p.Month, 1).ToString("MMMM yyyy"))
                                </span>
                            </td>
                            <td class="text-end">₹@p.BasicSalary.ToString("N2")</td>
                            <td class="text-end">₹@p.HRA.ToString("N2")</td>
                            <td class="text-end">₹@p.OtherAllowances.ToString("N2")</td>
                            <td class="text-end text-danger">-₹@p.Deductions.ToString("N2")</td>
                            <td class="text-end fw-bold text-success">₹@net.ToString("N2")</td>
                            <td class="text-center">
                                @if (p.Status == "Paid")
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Paid</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i>Pending</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="d-flex gap-1 justify-content-center flex-wrap">
                                    <a class="btn btn-sm btn-outline-info"
                                       asp-action="Details"
                                       asp-route-id="@p.Id"
                                       title="View Slip">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a class="btn btn-sm btn-outline-primary"
                                       asp-action="Edit"
                                       asp-route-id="@p.Id"
                                       title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    @if (p.Status == "Pending")
                                    {
                                        <form asp-action="MarkAsPaid"
                                              asp-route-id="@p.Id"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Mark this payroll as Paid?');">
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn-sm btn-outline-success" title="Mark as Paid">
                                                <i class="bi bi-cash-stack"></i>
                                            </button>
                                        </form>
                                    }
                                    <form asp-action="Delete"
                                          asp-route-id="@p.Id"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Delete this payroll record?');">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-sm btn-outline-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
