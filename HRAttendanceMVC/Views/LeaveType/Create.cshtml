@model LeaveType
@{
    ViewData["Title"] = "Add Leave Type";
}
<h2>Add Leave Type</h2>
<form asp-action="Create" method="post" class="card p-4 mt-3">
    @Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label asp-for="Name"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="TotalDays"></label><input asp-for="TotalDays" class="form-control" /><span asp-validation-for="TotalDays" class="text-danger"></span></div>
    <button class="btn btn-primary mb-2">Save</button> <a class="btn btn-secondary" asp-action="Index">Back</a>
</form>
@section Scripts {
<partial name="_ValidationScriptsPartial" />
 }
