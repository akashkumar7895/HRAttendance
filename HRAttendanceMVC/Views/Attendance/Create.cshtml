@model Attendance
@{
    ViewData["Title"] = "Mark Attendance";
    var employees = ViewBag.Employees as IEnumerable<Employee> ?? Enumerable.Empty<Employee>();
    bool isEmployee = User.IsInRole("Employee");
    bool isExisting = (ViewBag.IsExistingRecord == true) || (Model.Id > 0);
    bool isPunchedIn = Model.CheckIn.HasValue;
    bool isPunchedOut = Model.CheckOut.HasValue;
    string checkInDisplay = Model.CheckIn.HasValue ? DateTime.Today.Add(Model.CheckIn.Value).ToString("hh:mm tt") : "--:--";
    string checkOutDisplay = Model.CheckOut.HasValue ? DateTime.Today.Add(Model.CheckOut.Value).ToString("hh:mm tt") : "--:--";
}

<div class="container py-3" style="max-width: 1000px;">
    <!-- Page Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h2 class="mb-0 fw-bold">
                <i class="fa-solid fa-calendar-check text-purple me-2"></i>Mark Attendance
            </h2>
            
        </div>
        <div>
            <a class="btn btn-outline-secondary" asp-action="Index">
                <i class="fa-solid fa-arrow-left me-1"></i> Attendance History
            </a>
            <a class="btn btn-outline-primary ms-1" asp-controller="Dashboard" asp-action="Index">
                <i class="fa-solid fa-gauge me-1"></i> Dashboard
            </a>
        </div>
    </div>

    <!-- ==============================================================
         1-CLICK PUNCH IN / OUT WIDGET (ONLY FOR EMPLOYEE)
    ============================================================== -->
    @if (isEmployee)
    {
        <div class="punch-card shadow-sm border-0 mb-4" id="punchWidgetStation" 
             data-punched-in="@(isPunchedIn ? "true" : "false")" 
             data-punched-out="@(isPunchedOut ? "true" : "false")" 
             data-checkin-raw="@(Model.CheckIn?.ToString(@"hh\:mm\:ss") ?? "")" 
             data-checkout-raw="@(Model.CheckOut?.ToString(@"hh\:mm\:ss") ?? "")">
            
            <div class="punch-card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div class="d-flex align-items-center gap-2">
                    <div class="avatar-circle">
                        <i class="fa-solid fa-fingerprint fs-4 text-purple"></i>
                    </div>
                    <div>
                        <h5 class="mb-0 fw-bold">Quick Punch Station</h5>
                        <span class="text-muted small">Live synchronized with your dashboard &amp; attendance records</span>
                    </div>
                </div>

                <div class="header-clock-pill d-flex align-items-center gap-2">
                    <i class="fa-regular fa-calendar-check text-purple"></i>
                    <span id="liveCurrentDate" class="fw-semibold text-secondary">--</span>
                    <span class="clock-divider">|</span>
                    <i class="fa-regular fa-clock text-purple"></i>
                    <span id="liveDigitalClock" class="fw-bold fs-6 text-dark font-monospace">--:--:--</span>
                </div>
            </div>

            <div class="punch-card-body p-3 p-md-4">
                <div class="row g-3 align-items-center">
                    <!-- Punch In -->
                    <div class="col-sm-4">
                        <div class="punch-stat-tile punch-stat-in">
                            <div class="tile-icon">
                                <i class="fa-solid fa-arrow-right-to-bracket"></i>
                            </div>
                            <div class="tile-content">
                                <span class="tile-label">Check In</span>
                                <h4 id="punchInDisplay" class="tile-value mb-0">@checkInDisplay</h4>
                                <span class="tile-sub text-muted">Arrival Time</span>
                            </div>
                        </div>
                    </div>

                    <!-- Live Stopwatch -->
                    <div class="col-sm-4">
                        <div class="punch-stat-tile punch-stat-timer @(isPunchedIn && !isPunchedOut ? "active-glow" : "")" id="punchTimerTile">
                            <div class="tile-icon">
                                <i class="fa-solid fa-stopwatch @(isPunchedIn && !isPunchedOut ? "fa-spin" : "")" id="stopwatchIcon"></i>
                            </div>
                            <div class="tile-content">
                                <span class="tile-label">Live Work Timer</span>
                                <h4 id="punchLiveTimerDisplay" class="tile-value mb-0 font-monospace text-primary">00h 00m 00s</h4>
                                <span id="punchTimerSub" class="tile-sub text-muted">
                                    @(isPunchedOut ? "Shift Completed" : (isPunchedIn ? "Active Working" : "Not Started"))
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Punch Out -->
                    <div class="col-sm-4">
                        <div class="punch-stat-tile punch-stat-out">
                            <div class="tile-icon">
                                <i class="fa-solid fa-arrow-right-from-bracket"></i>
                            </div>
                            <div class="tile-content">
                                <span class="tile-label">Check Out</span>
                                <h4 id="punchOutDisplay" class="tile-value mb-0">@checkOutDisplay</h4>
                                <span class="tile-sub text-muted">Departure Time</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Quick Action Buttons Strip -->
                <div class="mt-3 d-flex flex-wrap align-items-center justify-content-between gap-2 pt-2 border-top">
                    <div class="d-flex align-items-center gap-2">
                        <span class="small text-muted fw-semibold">Status:</span>
                        <span id="punchStatusBadge" class="badge rounded-pill px-3 py-2 fs-7 
                            @(isPunchedOut ? "bg-info text-dark" : (isPunchedIn ? "bg-success text-white" : "bg-secondary text-white"))">
                            <i id="punchStatusIcon" class="fa-solid @(isPunchedOut ? "fa-circle-check" : (isPunchedIn ? "fa-circle-play" : "fa-circle-dot")) me-1"></i>
                            <span id="punchStatusText">
                                @(isPunchedOut ? "Completed for Today" : (isPunchedIn ? "Punched In / Working" : "Not Punched In"))
                            </span>
                        </span>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <button type="button" 
                                id="btnPunchIn" 
                                class="btn btn-punch-in btn-sm fw-bold px-3 py-2"
                                style="@(isPunchedIn ? "display:none;" : "")">
                            <i class="fa-solid fa-fingerprint me-1"></i> 1-Click Punch In
                        </button>

                        <button type="button" 
                                id="btnPunchOut" 
                                class="btn btn-punch-out btn-sm fw-bold px-3 py-2"
                                style="@(!isPunchedIn || isPunchedOut ? "display:none;" : "")">
                            <i class="fa-solid fa-right-from-bracket me-1"></i> Punch Out &amp; Finish
                        </button>

                        <div id="punchCompletedBanner" 
                             class="alert alert-success d-flex align-items-center mb-0 py-1 px-3 small rounded-3"
                             style="@(!isPunchedOut ? "display:none !important;" : "")">
                            <i class="fa-solid fa-circle-check fs-5 text-success me-2"></i>
                            <div><strong>Shift Completed!</strong> Great job today.</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- ==============================================================
         MANUAL ATTENDANCE FORM (WITH INSTANT SYNC & NOW BUTTONS)
    ============================================================== -->
    <div class="card border-0 shadow-sm rounded-4 p-4">
        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
            <h5 class="mb-0 fw-bold text-dark">
                <i class="fa-solid fa-pen-to-square text-purple me-2"></i>Detailed Attendance Form
            </h5>
            @if (isExisting)
            {
                <span class="badge bg-light text-success border px-3 py-1">
                    <i class="fa-solid fa-circle-check me-1"></i> Existing Record Loaded (Auto-Update Enabled)
                </span>
            }
        </div>

        <form asp-action="Create" method="post" id="attendanceMainForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

            <div class="row g-3">
                <!-- Employee Selection -->
                <div class="col-md-6 mb-2">
                    <label asp-for="EmployeeId" class="form-label fw-semibold">Employee <span class="text-danger">*</span></label>
                    @if (isEmployee)
                    {
                        <input type="hidden" asp-for="EmployeeId" id="selectEmployeeId" />
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="fa-solid fa-user"></i></span>
                            <input type="text" class="form-control bg-light" value="@User.Identity?.Name (You)" readonly />
                        </div>
                    }
                    else
                    {
                        <select asp-for="EmployeeId" class="form-select" id="selectEmployeeId">
                            <option value="">-- Select Employee --</option>
                            @foreach (var e in employees)
                            {
                                <option value="@e.Id" selected="@(e.Id == Model.EmployeeId ? "selected" : null)">
                                    @e.EmployeeCode - @e.FullName (@e.Department)
                                </option>
                            }
                        </select>
                        <span asp-validation-for="EmployeeId" class="text-danger small"></span>
                    }
                </div>

                <!-- Attendance Date -->
                <div class="col-md-6 mb-2">
                    <label asp-for="AttendanceDate" class="form-label fw-semibold">Attendance Date <span class="text-danger">*</span></label>
                    <input asp-for="AttendanceDate" type="date" class="form-control" id="attendanceDateInput" />
                    <span asp-validation-for="AttendanceDate" class="text-danger small"></span>
                </div>

                <!-- Status -->
                <div class="col-md-4 mb-2">
                    <label asp-for="Status" class="form-label fw-semibold">Status <span class="text-danger">*</span></label>
                    <select asp-for="Status" class="form-select" id="attendanceStatusSelect">
                        <option value="Present">Present</option>
                        <option value="Absent">Absent</option>
                        <option value="Half Day">Half Day</option>
                        <option value="Work From Home">Work From Home</option>
                        <option value="On Leave">On Leave</option>
                    </select>
                    <span asp-validation-for="Status" class="text-danger small"></span>
                </div>

                <!-- Check In with Quick 'Now' button -->
                <div class="col-md-4 mb-2">
                    <label asp-for="CheckIn" class="form-label fw-semibold">Check In Time</label>
                    <div class="input-group">
                        <input asp-for="CheckIn" type="time" class="form-control font-monospace" id="formCheckInInput" 
                               value="@(Model.CheckIn.HasValue ? Model.CheckIn.Value.ToString(@"hh\:mm") : "")" />
                        <button type="button" class="btn btn-outline-success" id="btnSetCheckInNow" title="Set current time">
                            <i class="fa-solid fa-clock me-1"></i> Now
                        </button>
                    </div>
                    <div class="form-text small text-muted">
                        Current: <strong id="checkInPreviewText">@(Model.CheckIn.HasValue ? DateTime.Today.Add(Model.CheckIn.Value).ToString("hh:mm tt") : "--:--")</strong>
                    </div>
                </div>

                <!-- Check Out with Quick 'Now' button -->
                <div class="col-md-4 mb-2">
                    <label asp-for="CheckOut" class="form-label fw-semibold">Check Out Time</label>
                    <div class="input-group">
                        <input asp-for="CheckOut" type="time" class="form-control font-monospace" id="formCheckOutInput" 
                               value="@(Model.CheckOut.HasValue ? Model.CheckOut.Value.ToString(@"hh\:mm") : "")" />
                        <button type="button" class="btn btn-outline-danger" id="btnSetCheckOutNow" title="Set current time">
                            <i class="fa-solid fa-clock me-1"></i> Now
                        </button>
                    </div>
                    <div class="form-text small text-muted">
                        Current: <strong id="checkOutPreviewText">@(Model.CheckOut.HasValue ? DateTime.Today.Add(Model.CheckOut.Value).ToString("hh:mm tt") : "--:--")</strong>
                    </div>
                </div>

                <!-- Remarks -->
                <div class="col-12 mb-3">
                    <label asp-for="Remarks" class="form-label fw-semibold">Remarks / Note</label>
                    <textarea asp-for="Remarks" class="form-control" id="formRemarksInput" rows="2" placeholder="e.g. Working from Office, Onsite Client Meeting, Shift note..."></textarea>
                    <span asp-validation-for="Remarks" class="text-danger small"></span>
                </div>
            </div>

            <!-- Submit Button Area -->
            <div class="d-flex align-items-center gap-2 pt-2 border-top">
                <button type="submit" class="btn btn-purple px-4 py-2 fw-bold shadow-sm">
                    <i class="fa-solid fa-floppy-disk me-1"></i> Save Attendance
                </button>
                <a class="btn btn-outline-secondary px-3 py-2" asp-action="Index">
                    Cancel
                </a>
                <span class="text-muted small ms-auto">
                    <i class="fa-solid fa-rotate text-success me-1"></i> Live synchronized with Dashboard &amp; Punch Station.
                </span>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/punch-station.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const formCheckInInput = document.getElementById('formCheckInInput');
            const formCheckOutInput = document.getElementById('formCheckOutInput');
            const checkInPreviewText = document.getElementById('checkInPreviewText');
            const checkOutPreviewText = document.getElementById('checkOutPreviewText');
            const btnSetCheckInNow = document.getElementById('btnSetCheckInNow');
            const btnSetCheckOutNow = document.getElementById('btnSetCheckOutNow');
            const selectEmployeeId = document.getElementById('selectEmployeeId');
            const attendanceDateInput = document.getElementById('attendanceDateInput');
            const attendanceStatusSelect = document.getElementById('attendanceStatusSelect');
            const formRemarksInput = document.getElementById('formRemarksInput');
            const punchInDisplay = document.getElementById('punchInDisplay');
            const punchOutDisplay = document.getElementById('punchOutDisplay');
            const station = document.getElementById('punchWidgetStation');

            function getCurrentTime24() {
                const now = new Date();
                const hh = String(now.getHours()).padStart(2, '0');
                const mm = String(now.getMinutes()).padStart(2, '0');
                const ss = String(now.getSeconds()).padStart(2, '0');
                return `${hh}:${mm}:${ss}`;
            }

            function formatTime12(timeStr) {
                if (!timeStr) return "--:--";
                const parts = timeStr.split(':');
                if (parts.length < 2) return "--:--";
                let h = parseInt(parts[0], 10);
                const m = parts[1];
                const ampm = h >= 12 ? 'PM' : 'AM';
                h = h % 12;
                h = h ? h : 12;
                return `${String(h).padStart(2, '0')}:${m} ${ampm}`;
            }

            // Quick 'Now' buttons for Check-In
            if (btnSetCheckInNow && formCheckInInput) {
                btnSetCheckInNow.addEventListener('click', function () {
                    const time24 = getCurrentTime24();
                    formCheckInInput.value = time24;
                    const disp12 = formatTime12(time24);
                    if (checkInPreviewText) checkInPreviewText.textContent = disp12;
                    if (punchInDisplay) punchInDisplay.textContent = disp12;
                    if (station) {
                        station.setAttribute('data-checkin-raw', time24);
                        station.setAttribute('data-punched-in', 'true');
                    }
                    if (attendanceStatusSelect && attendanceStatusSelect.value === 'Absent') {
                        attendanceStatusSelect.value = 'Present';
                    }
                });
            }

            // Quick 'Now' buttons for Check-Out
            if (btnSetCheckOutNow && formCheckOutInput) {
                btnSetCheckOutNow.addEventListener('click', function () {
                    const time24 = getCurrentTime24();
                    formCheckOutInput.value = time24;
                    const disp12 = formatTime12(time24);
                    if (checkOutPreviewText) checkOutPreviewText.textContent = disp12;
                    if (punchOutDisplay) punchOutDisplay.textContent = disp12;
                    if (station) {
                        station.setAttribute('data-checkout-raw', time24);
                        station.setAttribute('data-punched-out', 'true');
                    }
                });
            }

            // Sync input change with preview & Punch Station
            if (formCheckInInput) {
                formCheckInInput.addEventListener('input', function () {
                    const disp = formatTime12(this.value);
                    if (checkInPreviewText) checkInPreviewText.textContent = disp;
                    if (punchInDisplay) punchInDisplay.textContent = disp;
                    if (station) {
                        station.setAttribute('data-checkin-raw', this.value);
                        station.setAttribute('data-punched-in', this.value ? 'true' : 'false');
                    }
                });
            }

            if (formCheckOutInput) {
                formCheckOutInput.addEventListener('input', function () {
                    const disp = formatTime12(this.value);
                    if (checkOutPreviewText) checkOutPreviewText.textContent = disp;
                    if (punchOutDisplay) punchOutDisplay.textContent = disp;
                    if (station) {
                        station.setAttribute('data-checkout-raw', this.value);
                        station.setAttribute('data-punched-out', this.value ? 'true' : 'false');
                    }
                });
            }

            // Auto-fetch attendance record when employee or date changes (for HR / multi-employee)
            async function checkExistingRecord() {
                const empId = selectEmployeeId ? selectEmployeeId.value : '';
                const dateVal = attendanceDateInput ? attendanceDateInput.value : '';
                if (!empId || !dateVal) return;

                try {
                    const resp = await fetch(`/Attendance/GetAttendanceRecord?employeeId=${empId}&date=${dateVal}`);
                    const data = await resp.json();

                    // Sync the top Punch Station widget (live timer, tiles, buttons, status)
                    if (window.syncPunchStationFromData) {
                        window.syncPunchStationFromData(data);
                    }

                    if (data.found) {
                        if (attendanceStatusSelect && data.status) attendanceStatusSelect.value = data.status;
                        if (formCheckInInput) {
                            const val = data.checkIn || (data.checkInRaw ? data.checkInRaw.substring(0, 5) : '');
                            formCheckInInput.value = val;
                            if (checkInPreviewText) checkInPreviewText.textContent = data.checkInDisplay || formatTime12(val);
                        }
                        if (formCheckOutInput) {
                            const val = data.checkOut || (data.checkOutRaw ? data.checkOutRaw.substring(0, 5) : '');
                            formCheckOutInput.value = val;
                            if (checkOutPreviewText) checkOutPreviewText.textContent = data.checkOutDisplay || formatTime12(val);
                        }
                        if (formRemarksInput) formRemarksInput.value = data.remarks || '';
                    } else {
                        // Reset form fields cleanly if no record exists for this employee/date
                        if (formCheckInInput) {
                            formCheckInInput.value = '';
                            if (checkInPreviewText) checkInPreviewText.textContent = '--:--';
                        }
                        if (formCheckOutInput) {
                            formCheckOutInput.value = '';
                            if (checkOutPreviewText) checkOutPreviewText.textContent = '--:--';
                        }
                        if (attendanceStatusSelect) attendanceStatusSelect.value = 'Present';
                        if (formRemarksInput) formRemarksInput.value = '';
                    }
                } catch (e) {
                    console.log('Record lookup:', e);
                }
            }

            if (selectEmployeeId) selectEmployeeId.addEventListener('change', checkExistingRecord);
            if (attendanceDateInput) attendanceDateInput.addEventListener('change', checkExistingRecord);

            // Fetch record on load if employee is pre-selected
            if (selectEmployeeId && selectEmployeeId.value) {
                checkExistingRecord();
            }
        });
    </script>
}
