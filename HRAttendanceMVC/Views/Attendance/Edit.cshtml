@model Attendance
@{
    ViewData["Title"] = "Edit Attendance";
    var employees = ViewBag.Employees as IEnumerable<Employee> ?? Enumerable.Empty<Employee>();
    bool isEmployee = User.IsInRole("Employee");
}

<div class="container py-3" style="max-width: 900px;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-0 fw-bold">
                <i class="fa-solid fa-pen-to-square text-purple me-2"></i>Edit Attendance
            </h2>
            <p class="text-muted small mb-0">Modify check-in, check-out or status details for this attendance log.</p>
        </div>
        <a class="btn btn-outline-secondary" asp-action="Index">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to History
        </a>
    </div>

    <form asp-action="Edit" method="post" class="card border-0 shadow-sm rounded-4 p-4">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

        <div class="row g-3">
            <div class="col-md-6 mb-2">
                <label asp-for="EmployeeId" class="form-label fw-semibold">Employee</label>
                @if (isEmployee)
                {
                    <input type="hidden" asp-for="EmployeeId" />
                    <input type="text" class="form-control bg-light" value="@User.Identity?.Name" readonly />
                }
                else
                {
                    <select asp-for="EmployeeId" class="form-select">
                        @foreach (var e in employees)
                        {
                            <option value="@e.Id" selected="@(e.Id == Model.EmployeeId ? "selected" : null)">
                                @e.EmployeeCode - @e.FullName (@e.Department)
                            </option>
                        }
                    </select>
                }
            </div>

            <div class="col-md-6 mb-2">
                <label asp-for="AttendanceDate" class="form-label fw-semibold">Attendance Date</label>
                <input asp-for="AttendanceDate" type="date" class="form-control" />
                <span asp-validation-for="AttendanceDate" class="text-danger small"></span>
            </div>

            <div class="col-md-4 mb-2">
                <label asp-for="Status" class="form-label fw-semibold">Status</label>
                <select asp-for="Status" class="form-select">
                    <option value="Present">Present</option>
                    <option value="Absent">Absent</option>
                    <option value="Half Day">Half Day</option>
                    <option value="Work From Home">Work From Home</option>
                    <option value="On Leave">On Leave</option>
                </select>
                <span asp-validation-for="Status" class="text-danger small"></span>
            </div>

            <div class="col-md-4 mb-2">
                <label asp-for="CheckIn" class="form-label fw-semibold">Check In Time</label>
                <div class="input-group">
                    <input asp-for="CheckIn" type="time" class="form-control font-monospace" id="editCheckInInput" />
                    <button type="button" class="btn btn-outline-success" id="btnEditCheckInNow" title="Set current time">
                        <i class="fa-solid fa-clock me-1"></i> Now
                    </button>
                </div>
                <div class="form-text small text-muted">
                    Time: <strong id="editCheckInPreview">@(Model.CheckIn.HasValue ? DateTime.Today.Add(Model.CheckIn.Value).ToString("hh:mm tt") : "--:--")</strong>
                </div>
            </div>

            <div class="col-md-4 mb-2">
                <label asp-for="CheckOut" class="form-label fw-semibold">Check Out Time</label>
                <div class="input-group">
                    <input asp-for="CheckOut" type="time" class="form-control font-monospace" id="editCheckOutInput" />
                    <button type="button" class="btn btn-outline-danger" id="btnEditCheckOutNow" title="Set current time">
                        <i class="fa-solid fa-clock me-1"></i> Now
                    </button>
                </div>
                <div class="form-text small text-muted">
                    Time: <strong id="editCheckOutPreview">@(Model.CheckOut.HasValue ? DateTime.Today.Add(Model.CheckOut.Value).ToString("hh:mm tt") : "--:--")</strong>
                </div>
            </div>

            <div class="col-12 mb-3">
                <label asp-for="Remarks" class="form-label fw-semibold">Remarks</label>
                <textarea asp-for="Remarks" class="form-control" rows="2" placeholder="Remarks or notes..."></textarea>
                <span asp-validation-for="Remarks" class="text-danger small"></span>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2 pt-2 border-top">
            <button type="submit" class="btn btn-purple px-4 py-2 fw-bold shadow-sm">
                <i class="fa-solid fa-check me-1"></i> Update Attendance
            </button>
            <a class="btn btn-outline-secondary px-3 py-2" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const inInput = document.getElementById('editCheckInInput');
            const outInput = document.getElementById('editCheckOutInput');
            const inPreview = document.getElementById('editCheckInPreview');
            const outPreview = document.getElementById('editCheckOutPreview');

            function getCurrentTime24() {
                const now = new Date();
                return `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
            }

            function formatTime12(time24) {
                if (!time24) return "--:--";
                const parts = time24.split(':');
                let h = parseInt(parts[0], 10);
                const m = parts[1];
                const ampm = h >= 12 ? 'PM' : 'AM';
                h = h % 12;
                h = h ? h : 12;
                return `${String(h).padStart(2, '0')}:${m} ${ampm}`;
            }

            document.getElementById('btnEditCheckInNow')?.addEventListener('click', function () {
                const t = getCurrentTime24();
                if (inInput) inInput.value = t;
                if (inPreview) inPreview.textContent = formatTime12(t);
            });

            document.getElementById('btnEditCheckOutNow')?.addEventListener('click', function () {
                const t = getCurrentTime24();
                if (outInput) outInput.value = t;
                if (outPreview) outPreview.textContent = formatTime12(t);
            });

            inInput?.addEventListener('input', function () {
                if (inPreview) inPreview.textContent = formatTime12(this.value);
            });

            outInput?.addEventListener('input', function () {
                if (outPreview) outPreview.textContent = formatTime12(this.value);
            });
        });
    </script>
}
