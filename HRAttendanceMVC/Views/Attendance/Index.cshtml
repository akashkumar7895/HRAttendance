@model IEnumerable<Attendance>
@{
    ViewData["Title"] = "Attendance";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Attendance</h2>
    
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
  <form method="get" class="row g-2">
    <div class="col-auto"><input type="date" name="date" value="@ViewBag.SelectedDate" class="form-control" /></div>
    <div class="col-auto"><button class="btn btn-outline-primary">Search Date</button></div>
</form>
    <div>
        <a class="btn btn-secondary" asp-controller="Dashboard" asp-action="Index">Back</a>
        <a class="btn btn-primary" asp-action="Create">+ Mark Attendance</a>
    </div>
</div>
<div class="table-responsive card">
    <table class="table table-hover mb-0">
        <thead><tr><th>Employee</th><th>Date</th><th>Status</th><th>Check In</th><th>Check Out</th><th>Remarks</th><th>Action</th></tr></thead>
        <tbody>
            @foreach (var x in Model)
            {
                <tr>
                    <td>@x.Employee?.FullName</td>
                    <td>@x.AttendanceDate.ToString("dd-MM-yyyy")</td>
                    <td>@x.Status</td>
                    <td>@x.CheckIn?.ToString(@"hh\:mm")</td>
                    <td>@x.CheckOut?.ToString(@"hh\:mm")</td>
                    <td>@x.Remarks</td>
                    <td>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@x.Id">Edit</a>
                        <form asp-action="Delete" asp-route-id="@x.Id" method="post" class="d-inline" onsubmit="return confirm('Delete attendance?');">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-danger">Delete</button></form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
