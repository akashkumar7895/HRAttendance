@model IEnumerable<Attendance>
@{
    ViewData["Title"] = "Attendance History";
    int selectedMonth = ViewBag.SelectedMonth ?? DateTime.Today.Month;
    int selectedYear = ViewBag.SelectedYear ?? DateTime.Today.Year;
    string selectedDate = ViewBag.SelectedDate as string ?? "";
    string search = ViewBag.Search as string ?? "";
    string status = ViewBag.Status as string ?? "";
    int totalCount = ViewBag.TotalCount ?? (Model?.Count() ?? 0);
    int presentCount = ViewBag.PresentCount ?? 0;
    int absentCount = ViewBag.AbsentCount ?? 0;
    
    string monthName;
    try
    {
        monthName = new DateTime(selectedYear, selectedMonth, 1).ToString("MMMM");
    }
    catch
    {
        monthName = DateTime.Today.ToString("MMMM");
    }
}

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h2 class="mb-0 fw-bold">
                <i class="fa-solid fa-calendar-check text-primary me-2"></i>Attendance History
            </h2>
            
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" asp-controller="Dashboard" asp-action="Index">
                 Back
            </a>
            <a class="btn btn-primary" asp-action="Create">
                <i class="fa-solid fa-plus me-1"></i> Mark Attendance
            </a>
        </div>
    </div>

    <!-- Summary Stats Row -->
    <div class="row g-3 mb-3">
        <div class="col-sm-6 col-md-3">
            <div class="card border-0 shadow-sm p-3 bg-light">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small d-block">Period</span>
                        <strong class="fs-6 text-dark">@monthName @selectedYear</strong>
                    </div>
                    <i class="fa-regular fa-calendar text-primary fs-4"></i>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="card border-0 shadow-sm p-3 bg-light">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small d-block">Total Logs</span>
                        <strong class="fs-5 text-dark" id="statTotalCount">@totalCount</strong>
                    </div>
                    <i class="fa-solid fa-clipboard-list text-secondary fs-4"></i>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="card border-0 shadow-sm p-3 bg-light">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small d-block">Present</span>
                        <strong class="fs-5 text-success" id="statPresentCount">@presentCount</strong>
                    </div>
                    <i class="fa-solid fa-user-check text-success fs-4"></i>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="card border-0 shadow-sm p-3 bg-light">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small d-block">Absent</span>
                        <strong class="fs-5 text-danger" id="statAbsentCount">@absentCount</strong>
                    </div>
                    <i class="fa-solid fa-user-xmark text-danger fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter & Search Card -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-end" id="attendanceFilterForm">
                <!-- Search Bar -->
                <div class="col-12 col-md-4">
                    <label class="form-label small fw-semibold text-muted mb-1">
                        <i class="fa-solid fa-magnifying-glass me-1"></i>Search Records      
                    </label>
                    <input type="text" 
                           id="attendanceSearchInput" 
                           name="search" 
                           value="@search" 
                           class="form-control" 
                           placeholder="Search" 
                           autocomplete="off" />
                </div>

                <!-- Month Selector -->
                <div class="col-6 col-sm-4 col-md-2">
                    <label class="form-label small fw-semibold text-muted mb-1">Month</label>
                    <select name="month" class="form-select">
                        @{
                            var months = new[] {
                                (1, "January"), (2, "February"), (3, "March"), (4, "April"),
                                (5, "May"), (6, "June"), (7, "July"), (8, "August"),
                                (9, "September"), (10, "October"), (11, "November"), (12, "December")
                            };
                            foreach (var (mNum, mLabel) in months)
                            {
                                if (mNum == selectedMonth)
                                {
                                    <option value="@mNum" selected="selected">@mLabel</option>
                                }
                                else
                                {
                                    <option value="@mNum">@mLabel</option>
                                }
                            }
                        }
                    </select>
                </div>

                <!-- Year Selector -->
                <div class="col-6 col-sm-4 col-md-2">
                    <label class="form-label small fw-semibold text-muted mb-1">Year</label>
                    <select name="year" class="form-select">
                        @{
                            int currentYear = DateTime.Today.Year;
                            for (int y = currentYear - 3; y <= currentYear + 2; y++)
                            {
                                if (y == selectedYear)
                                {
                                    <option value="@y" selected="selected">@y</option>
                                }
                                else
                                {
                                    <option value="@y">@y</option>
                                }
                            }
                        }
                    </select>
                </div>

                <!-- Status Filter -->
                <div class="col-6 col-sm-4 col-md-2">
                    <label class="form-label small fw-semibold text-muted mb-1">Status</label>
                    <select name="status" class="form-select">
                        <option value="">All Statuses</option>
                        @foreach (var opt in new[] { "Present", "Absent", "Half Day", "Work From Home", "On Leave" })
                        {
                            if (status == opt)
                            {
                                <option value="@opt" selected="selected">@opt</option>
                            }
                            else
                            {
                                <option value="@opt">@opt</option>
                            }
                        }
                    </select>
                </div>

                <!-- Optional Specific Date -->
                <div class="col-6 col-sm-6 col-md-2">
                    <label class="form-label small fw-semibold text-muted mb-1">Exact Date (Optional)</label>
                    <input type="date" name="date" value="@selectedDate" class="form-control" />
                </div>

                <!-- Submit / Reset Buttons -->
                <div class="col-12 d-flex justify-content-end gap-2 mt-2">
                    <button type="submit" class="btn btn-primary px-3">
                        <i class="fa-solid fa-filter me-1"></i> Apply Filter
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-3" title="Reset to current month">
                        <i class="fa-solid fa-rotate-left me-1"></i> Reset
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Attendance Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold text-dark fs-6">
                <i class="fa-solid fa-list-check text-primary me-2"></i>
                @if (!string.IsNullOrEmpty(selectedDate))
                {
                    <span>Records for Date: @selectedDate</span>
                }
                else
                {
                    <span>Attendance Records for @monthName @selectedYear</span>
                }
            </h5>
            <span class="badge bg-primary rounded-pill px-3 py-2" id="visibleRowCountBadge">
                @(Model?.Count() ?? 0) records
            </span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="attendanceTable">
                <thead class="table-light text-uppercase small text-muted">
                    <tr>
                        <th style="width: 50px;">#</th>
                        <th>Employee</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Check In</th>
                        <th>Check Out</th>
                        <th>Remarks</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int index = 1;
                        foreach (var x in Model)
                        {
                            string badgeClass = x.Status switch
                            {
                                "Present" => "bg-success text-white",
                                "Absent" => "bg-danger text-white",
                                "Half Day" => "bg-warning text-dark",
                                "Work From Home" => "bg-info text-white",
                                "On Leave" => "bg-secondary text-white",
                                _ => "bg-light text-dark border"
                            };

                            <tr class="attendance-row">
                                <td class="text-muted small">@index</td>
                                <td>
                                    <div class="fw-semibold text-dark">@x.Employee?.FullName</div>
                                    @if (!string.IsNullOrEmpty(x.Employee?.EmployeeCode))
                                    {
                                        <span class="badge bg-light text-secondary border small" style="font-size: 10px;">
                                            @x.Employee.EmployeeCode
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="fw-medium">@x.AttendanceDate.ToString("dd-MM-yyyy")</div>
                                    <span class="text-muted small" style="font-size: 11px;">
                                        @x.AttendanceDate.ToString("dddd")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @badgeClass px-2 py-1">
                                        @x.Status
                                    </span>
                                </td>
                                <td>
                                    @if (x.CheckIn.HasValue)
                                    {
                                        <span class="badge bg-light text-dark border font-monospace px-2 py-1">
                                            <i class="fa-solid fa-arrow-right-to-bracket text-success me-1"></i>@(DateTime.Today.Add(x.CheckIn.Value).ToString("hh:mm tt"))
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                <td>
                                    @if (x.CheckOut.HasValue)
                                    {
                                        <span class="badge bg-light text-dark border font-monospace px-2 py-1">
                                            <i class="fa-solid fa-arrow-right-from-bracket text-danger me-1"></i>@(DateTime.Today.Add(x.CheckOut.Value).ToString("hh:mm tt"))
                                        </span>
                                        @if (x.CheckIn.HasValue)
                                        {
                                            var diff = x.CheckOut.Value - x.CheckIn.Value;
                                            <div class="text-muted small mt-1" style="font-size: 11px;">
                                                <i class="fa-regular fa-clock me-1 text-primary"></i>@((int)diff.TotalHours)h @(diff.Minutes)m
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                <td>
                                    <span class="text-muted small">
                                        @(string.IsNullOrWhiteSpace(x.Remarks) ? "-" : x.Remarks)
                                    </span>
                                </td>
                                <td>
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@x.Id">Edit</a>
                                    <form asp-action="Delete" asp-route-id="@x.Id" method="post" class="d-inline" onsubmit="return confirm('Delete attendance?');">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-danger">Delete</button></form>
                                </td>
                            </tr>
                            index++;
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="fa-regular fa-calendar-xmark text-muted fs-1 mb-3 d-block"></i>
                <h5 class="fw-bold text-dark">No Attendance Records Found</h5>
                <p class="text-muted small mb-3">
                    No attendance logs match the selected period (@monthName @selectedYear) or search criteria.
                </p>
                <a asp-action="Create" class="btn btn-primary btn-sm">
                    <i class="fa-solid fa-plus me-1"></i> Mark Attendance Now
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Real-Time Live Client Search Bar Filter
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('attendanceSearchInput');
            const table = document.getElementById('attendanceTable');
            const badge = document.getElementById('visibleRowCountBadge');

            if (!searchInput || !table) return;

            searchInput.addEventListener('input', function () {
                const query = this.value.toLowerCase().trim();
                const rows = table.querySelectorAll('tbody tr.attendance-row');
                let visibleCount = 0;

                rows.forEach(function (row) {
                    const rowText = row.textContent.toLowerCase();
                    if (rowText.includes(query)) {
                        row.style.display = '';
                        visibleCount++;
                    } else {
                        row.style.display = 'none';
                    }
                });

                if (badge) {
                    badge.textContent = visibleCount + ' records';
                }
            });
        });
    </script>
}
