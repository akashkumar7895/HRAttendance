@using HRAttendanceMVC.Domain.Helpers
@model IEnumerable<Attendance>

<div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th style="min-width: 100px;">Date</th>
                <th style="min-width: 160px;">Employee</th>
                <th style="min-width: 120px;">Check In</th>
                <th style="min-width: 120px;">Check Out</th>
                <th style="min-width: 150px;">Punch Source</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var x in Model)
            {
                var punchSrc = string.IsNullOrEmpty(x.PunchSource) ? "Web Portal" : x.PunchSource;
                var inSrc = string.IsNullOrEmpty(x.CheckInSource) ? punchSrc : x.CheckInSource;
                var outSrc = string.IsNullOrEmpty(x.CheckOutSource) ? punchSrc : x.CheckOutSource;

                <tr>
                    <td>
                        <div class="fw-semibold text-dark">@x.AttendanceDate.ToString("dd-MM-yyyy")</div>
                        <small class="text-muted">@x.AttendanceDate.ToString("dddd")</small>
                    </td>
                    <td>
                        <div class="fw-semibold text-dark">@(x.Employee?.FullName ?? $"Employee #{x.EmployeeId}")</div>
                        @if (!string.IsNullOrEmpty(x.Employee?.EmployeeCode))
                        {
                            <span class="badge bg-light text-secondary border" style="font-size: 10px;">
                                @x.Employee.EmployeeCode
                            </span>
                        }
                    </td>
                    <td>
                        @if (x.CheckIn.HasValue)
                        {
                            <div><strong class="font-monospace text-dark">@TimeHelper.Format12(x.CheckIn)</strong></div>
                            @if (inSrc == "Biometric Machine")
                            {
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-0 mt-1" style="font-size: 10px;">
                                    <i class="fa-solid fa-fingerprint me-1"></i>Machine
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-light text-purple border px-2 py-0 mt-1" style="font-size: 10px;">
                                    <i class="fa-solid fa-globe me-1"></i>Web
                                </span>
                            }
                        }
                        else
                        {
                            <span class="text-muted small">--:--</span>
                        }
                    </td>
                    <td>
                        @if (x.CheckOut.HasValue)
                        {
                            <div><strong class="font-monospace text-dark">@TimeHelper.Format12(x.CheckOut)</strong></div>
                            @if (outSrc == "Biometric Machine")
                            {
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-0 mt-1" style="font-size: 10px;">
                                    <i class="fa-solid fa-fingerprint me-1"></i>Machine
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-light text-purple border px-2 py-0 mt-1" style="font-size: 10px;">
                                    <i class="fa-solid fa-globe me-1"></i>Web
                                </span>
                            }
                        }
                        else
                        {
                            <span class="text-muted small">--:--</span>
                        }
                    </td>
                    <td>
                        @if (punchSrc == "Biometric Machine")
                        {
                            <span class="badge bg-primary text-white px-2 py-1 shadow-sm">
                                <i class="fa-solid fa-fingerprint me-1"></i> Biometric Machine
                            </span>
                            @if (!string.IsNullOrEmpty(x.DeviceId))
                            {
                                <div class="text-muted small mt-1" style="font-size: 10px;">@x.DeviceId</div>
                            }
                        }
                        else if (punchSrc == "Hybrid")
                        {
                            <span class="badge bg-warning text-dark px-2 py-1 shadow-sm">
                                <i class="fa-solid fa-arrows-split-up-and-left me-1"></i> Hybrid (Bio + Web)
                            </span>
                        }
                        else if (punchSrc == "Manual Entry")
                        {
                            <span class="badge bg-secondary text-white px-2 py-1">
                                <i class="fa-solid fa-pen-to-square me-1"></i> Manual Entry
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-purple text-white px-2 py-1 shadow-sm">
                                <i class="fa-solid fa-globe me-1"></i> Web Portal
                            </span>
                        }
                    </td>
                    <td>
                        <span class="badge @(x.Status == "Present" ? "bg-success" : (x.Status == "Absent" ? "bg-danger" : "bg-warning text-dark")) px-2 py-1">
                            @x.Status
                        </span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
