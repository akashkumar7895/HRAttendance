    <script>

            // Auto hide Success / Error messages
             document.querySelectorAll('.auto-hide-alert').forEach(function (alert) {

              const hideTime = parseInt(
             alert.getAttribute('data-auto-hide')
             ) || 3000;

             setTimeout(function () {

             // Bootstrap fade effect
              alert.classList.remove('show');

             // Completely remove after fade
             setTimeout(function () {
             alert.remove();
          }, 3000);

       }, hideTime);
    });
        document.addEventListener('DOMContentLoaded', function () {
            const dropdownToggles = document.querySelectorAll('.navbar-custom .dropdown-toggle');

            dropdownToggles.forEach(function (toggle) {
                toggle.addEventListener('click', function (e) {
                    e.preventDefault();
                    e.stopPropagation();

                    const parent = toggle.closest('.dropdown');
                    const menu = parent ? parent.querySelector('.dropdown-menu') : null;
                    const isOpen = menu && menu.classList.contains('show');

                    // Close all dropdowns
                    document.querySelectorAll('.navbar-custom .dropdown-menu').forEach(function (m) {
                        m.classList.remove('show');
                    });
                    document.querySelectorAll('.navbar-custom .dropdown-toggle').forEach(function (t) {
                        t.classList.remove('show');
                        t.setAttribute('aria-expanded', 'false');
                    });

                    // Toggle clicked dropdown
                    if (!isOpen && menu) {
                        menu.classList.add('show');
                        toggle.classList.add('show');
                        toggle.setAttribute('aria-expanded', 'true');
                    }
                });
            });

            // Close dropdowns when clicking outside
            document.addEventListener('click', function (e) {
                if (!e.target.closest('.navbar-custom .dropdown')) {
                    document.querySelectorAll('.navbar-custom .dropdown-menu').forEach(function (m) {
                        m.classList.remove('show');
                    });
                    document.querySelectorAll('.navbar-custom .dropdown-toggle').forEach(function (t) {
                        t.classList.remove('show');
                        t.setAttribute('aria-expanded', 'false');
                    });
                }
            });
        });
    </script>
