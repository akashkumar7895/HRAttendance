                </div>
                <div class="engage-modal-bottom">
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" onclick="closeSendWishPopup()">Cancel</button>
                    <button type="button" class="btn btn-purple btn-sm rounded-pill px-4" onclick="confirmDispatchWish()">
                        <i class="bi bi-stars me-1"></i> Send Wishes 🎉
                    </button>
                </div>
            </div>
        </div>

        <!-- Toast Alert Notification -->
        <div class="engage-alert-toast" id="engageGlobalToast">
            <i class="bi bi-check-circle-fill text-success fs-5"></i>
            <span id="engageGlobalToastMessage">Action completed successfully!</span>
        </div>

        <!-- Confetti CDN Script -->
        <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>

        <!-- Client Scripts -->
        <script>
            let userPollVoted = false;

            function triggerToastNotice(msg) {
                const toast = document.getElementById("engageGlobalToast");
                const label = document.getElementById("engageGlobalToastMessage");
                if (toast && label) {
                    label.innerText = msg;
                    toast.classList.add("show");
                    setTimeout(() => { toast.classList.remove("show"); }, 3500);
                }
            }

            function blastCelebrationConfetti() {
                if (typeof confetti === "function") {
                    confetti({ particleCount: 90, spread: 70, origin: { y: 0.6 } });
                }
            }

            function switchEngageSection(targetId, btn) {
                document.querySelectorAll(".tab-nav-btn").forEach(b => b.classList.remove("active"));
                if (btn) btn.classList.add("active");

                const sections = document.querySelectorAll(".engage-block-section");
                if (targetId === "all") {
                    sections.forEach(s => s.style.display = "block");
                } else {
                    sections.forEach(s => {
                        if (s.id === "block-" + targetId) {
                            s.style.display = "block";
                            s.scrollIntoView({ behavior: "smooth", block: "start" });
                        } else {
                            s.style.display = "none";
                        }
                    });
                }
            }

            function filterNewsByCat(cat, btn) {
                document.querySelectorAll(".filter-btn-pill").forEach(p => p.classList.remove("active"));
                if (btn) btn.classList.add("active");

                const cards = document.querySelectorAll("#newsCardsGrid .news-card-item");
                cards.forEach(c => {
                    const cardCat = c.getAttribute("data-cat") || "";
                    if (cat === "all" || cardCat.toLowerCase() === cat.toLowerCase()) {
                        c.style.display = "flex";
                    } else {
                        c.style.display = "none";
                    }
                });
            }

            function searchNewsCards() {
                const query = (document.getElementById("newsSearchInput").value || "").toLowerCase();
                const cards = document.querySelectorAll("#newsCardsGrid .news-card-item");
                cards.forEach(c => {
                    const searchAttr = (c.getAttribute("data-search") || "").toLowerCase();
                    if (searchAttr.includes(query)) {
                        c.style.display = "flex";
                    } else {
                        c.style.display = "none";
                    }
                });
            }

            function showNewsModal(title, author, date, body) {
                document.getElementById("newsModalHeading").innerHTML = '<i class="bi bi-newspaper text-purple me-2"></i>' + title;
                document.getElementById("newsModalAuthorName").innerText = author;
                document.getElementById("newsModalPublishDate").innerText = date;
                document.getElementById("newsModalFullText").innerText = body;
                document.getElementById("engageNoticeDetailModal").classList.add("active");
            }

            function closeNewsDetailModal() {
                document.getElementById("engageNoticeDetailModal").classList.remove("active");
            }

            function openCreateNoticeModal() {
                document.getElementById("engageCreateNoticeModal").classList.add("active");
            }

            function closeCreateNoticeModal() {
                document.getElementById("engageCreateNoticeModal").classList.remove("active");
            }

            function openCreateEventModal() {
                document.getElementById("engageCreateEventModal").classList.add("active");
            }

            function closeCreateEventModal() {
                document.getElementById("engageCreateEventModal").classList.remove("active");
            }

            function openCreateCelebrationModal() {
                document.getElementById("engageCreateCelebrationModal").classList.add("active");
            }

            function closeCreateCelebrationModal() {
                document.getElementById("engageCreateCelebrationModal").classList.remove("active");
            }

            function toggleEventAttendance(eventId, counterId, btn) {
                fetch('/Footer/ToggleEventRsvp?id=' + eventId, { method: 'POST' })
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) {
                            document.getElementById(counterId).innerText = data.count;
                            btn.classList.add("attending");
                            btn.innerHTML = '<i class="bi bi-check-circle-fill"></i> Attending! ✅';
                            blastCelebrationConfetti();
                            triggerToastNotice("RSVP recorded! Thank you!");
                        }
                    })
                    .catch(() => triggerToastNotice("RSVP updated!"));
            }

            function toggleCelebrationsTab(type, btn) {
                document.querySelectorAll(".btn-sub-toggle").forEach(b => b.classList.remove("active"));
                if (btn) btn.classList.add("active");

                const bView = document.getElementById("celebrationsBirthdaysView");
                const aView = document.getElementById("celebrationsAnniversariesView");

                if (type === "birthdays") {
                    bView.style.display = "block";
                    aView.style.display = "none";
                } else {
                    bView.style.display = "none";
                    aView.style.display = "block";
                }
            }

            function showSendWishPopup(name, occasion, defMsg) {
                document.getElementById("wishColleagueName").value = name;
                document.getElementById("wishOccasionLabel").value = occasion;
                document.getElementById("wishMessageTextarea").value = defMsg;
                document.getElementById("engageSendWishModal").classList.add("active");
            }

            function closeSendWishPopup() {
                document.getElementById("engageSendWishModal").classList.remove("active");
            }

            function confirmDispatchWish() {
                const name = document.getElementById("wishColleagueName").value;
                closeSendWishPopup();
                blastCelebrationConfetti();
                triggerToastNotice(`Your warm wishes have been sent to ${name}! 🎈🎉`);
            }

            function setPostCategoryVal(cat, btn) {
                document.getElementById("hiddenPostCategory").value = cat;
                document.querySelectorAll(".btn-tag-select").forEach(b => b.classList.remove("active"));
                if (btn) btn.classList.add("active");
            }

            function likePostAjax(postId, counterId, btn) {
                fetch('/Footer/LikePost?id=' + postId, { method: 'POST' })
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) {
                            document.getElementById(counterId).innerText = data.likes;
                            btn.classList.add("liked");
                            btn.innerHTML = '<i class="bi bi-heart-fill"></i> Liked';
                            triggerToastNotice("You liked this post!");
                        }
                    })
                    .catch(() => triggerToastNotice("Liked!"));
            }

            function focusCommentBox(id) {
                const el = document.getElementById(id);
                if (el) el.focus();
            }

            function handleFeedCommentKey(e, id) {
                if (e.key === "Enter") addFeedComment(id);
            }

            function addFeedComment(id) {
                const input = document.getElementById("comment-field-" + id);
                const txt = input ? input.value.trim() : "";
                if (!txt) return;

                const parent = document.getElementById("dynamicCommentsFeed-" + id);
                const cRow = document.createElement("div");
                cRow.className = "comment-row";
                cRow.innerHTML = `
                    <div class="author-avatar-img purple" style="width:28px;height:28px;font-size:0.75rem;">@(string.IsNullOrEmpty(User.Identity?.Name) ? "U" : User.Identity.Name.Substring(0, 1).ToUpper())</div>
                    <div class="comment-content-bubble">
                        <strong>@(User.Identity?.Name ?? "You")</strong>
                        <p>${txt}</p>
                    </div>
                `;

                if (parent) parent.appendChild(cRow);
                if (input) input.value = "";
                triggerToastNotice("Comment added!");
            }

            function votePollOption(opt) {
                if (userPollVoted) {
                    triggerToastNotice("You have already voted!");
                    return;
                }
                userPollVoted = true;
                document.querySelectorAll(".poll-single-option").forEach(item => item.classList.remove("voted"));
                const items = document.querySelectorAll(".poll-single-option");
                if (items[opt - 1]) items[opt - 1].classList.add("voted");

                if (opt === 1) {
                    document.getElementById("pollBar1").style.width = "52%";
                    document.getElementById("pollPct1").innerText = "52% (39 votes) ✓";
                } else if (opt === 2) {
                    document.getElementById("pollBar2").style.width = "36%";
                    document.getElementById("pollPct2").innerText = "36% (26 votes) ✓";
                } else if (opt === 3) {
                    document.getElementById("pollBar3").style.width = "24%";
                    document.getElementById("pollPct3").innerText = "24% (17 votes) ✓";
                }
                blastCelebrationConfetti();
                triggerToastNotice("Your vote has been cast! Thank you!");
            }
        </script>
    }
    else if (pageType == "guideleavemanagement")
    {
        <div class="guide-page">
            <!-- HERO SECTION -->
            <section class="guide-hero leave-hero">
                <div class="guide-container">
                    <div class="guide-breadcrumb">
                        <a asp-controller="Dashboard" asp-action="Index">Home</a>
                        <i class="bi bi-chevron-right"></i>
                        <span>Resources</span>
                        <i class="bi bi-chevron-right"></i>
                        <span>Guide to Leave Management</span>
                    </div>

                    <div class="guide-hero-grid">
                        <div>
                            <div class="guide-badge">
                                <span class="dot"></span>
                                Leave Operations &amp; Compliance Playbook
                            </div>
                            <h1>
                                Mastering Workforce <br />
                                <span class="highlight-blue">Leave Management</span>
                            </h1>
                            <p class="guide-hero-description">
                                A comprehensive strategic guide for HR leaders and organizations to design fair leave policies, streamline self-service time-off requests, eliminate employee disputes, and sync leave records seamlessly with monthly payroll.
                            </p>
                            <div class="guide-hero-actions">
                                @if (User.IsInRole("HR"))
