            function switchVideo(videoId, title, desc, metaCategory) {
                currentVideoId = videoId;
                
                // Update player metadata text
                document.getElementById('currentVideoTitle').innerText = title;
                document.getElementById('currentVideoDesc').innerText = desc;
                document.getElementById('metaVideoTitle').innerText = title;
                
                // Scroll up smoothly to main video player
                document.getElementById('mainVideoPlayer').scrollIntoView({ behavior: 'smooth', block: 'center' });
                
