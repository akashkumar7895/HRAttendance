                    <button type="button" class="btn-dismiss-modal" onclick="closeSendWishPopup()">&times;</button>
                </div>
                <div class="engage-modal-content-area">
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Colleague</label>
                        <input type="text" id="wishColleagueName" class="form-control" readonly style="background:#f9fafb; font-weight:600;" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">Occasion</label>
                        <input type="text" id="wishOccasionLabel" class="form-control" readonly style="background:#f9fafb;" />
                    </div>
