                var iframe = document.getElementById('videoIframe');
                
                var idToPlay = videoId || currentVideoId;
                var embedUrl = "https://www.youtube.com/embed/" + idToPlay + "?autoplay=1&rel=0&modestbranding=1";
                
                iframe.src = embedUrl;
                playerContainer.classList.add('playing');
