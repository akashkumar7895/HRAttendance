                    </div>
                </div>
            </section>

            <!-- SECTION 5: CALL TO ACTION -->
            <section class="guide-cta-section">
                <div class="guide-container">
                    <div class="guide-cta-card">
                        <div>
                            <h2>Ready to modernise your organization’s leave system?</h2>
                            <p>Take control of employee time-off, automate approval workflows, and synchronize records directly with monthly payroll.</p>
                        </div>
                        <div class="guide-cta-actions">
                            @if (User.IsInRole("HR"))
                            {
                                <a asp-controller="LeaveType" asp-action="Create" class="btn-guide-primary">
