            function performHelpSearch() {
                var query = document.getElementById('helpSearchInput').value.toLowerCase().trim();
                if (!query) return;

                var faqItems = document.querySelectorAll('.faq-item');
                var found = false;

                faqItems.forEach(function(item) {
                    var text = item.textContent.toLowerCase();
                    if (text.includes(query)) {
                        item.classList.add('active');
                        if (!found) {
                            item.scrollIntoView({ behavior: 'smooth', block: 'center' });
                            found = true;
                        }
                    } else {
                        item.classList.remove('active');
                    }
                });

                if (!found) {
                    var topicsSection = document.getElementById('help-topics');
                    if (topicsSection) {
                        topicsSection.scrollIntoView({ behavior: 'smooth' });
                    }
                }
            }

            document.addEventListener('DOMContentLoaded', function() {
                var searchInput = document.getElementById('helpSearchInput');
                if (searchInput) {
                    searchInput.addEventListener('keypress', function(e) {
