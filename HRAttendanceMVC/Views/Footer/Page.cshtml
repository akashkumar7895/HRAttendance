                                        <i class="bi bi-calendar-check"></i> Review Leave Requests
                                    </a>
                                }
                                else if (User.IsInRole("Employee"))
                                {
                                    <a asp-controller="LeaveRequest" asp-action="Create" class="btn-guide-primary">
                                        <i class="bi bi-calendar-plus"></i> Apply for Leave
                                    </a>
                                    <a asp-controller="LeaveRequest" asp-action="Index" class="btn-guide-outline">
                                        <i class="bi bi-clock-history"></i> My Leave Applications
                                    </a>
                                }
                                else
                                {
                                    <a asp-controller="Account" asp-action="Login" class="btn-guide-primary">
                                        <i class="bi bi-box-arrow-in-right"></i> Access Leave Portal
                                    </a>
                                    <a href="#leave-types" class="btn-guide-outline">
                                        <i class="bi bi-arrow-down"></i> Explore Leave Types
                                    </a>
                                }
                            </div>
                        </div>

                        <div class="guide-hero-card">
                            <h4><i class="bi bi-shield-check"></i> Why Leave Tracking Matters</h4>
                            <ul>
                                <li>
                                    <i class="bi bi-check-circle-fill"></i>
                                    <span><strong>Eliminate Disputes:</strong> Transparent balances prevent arguments over remaining paid days and deductions.</span>
                                </li>
                                <li>
                                    <i class="bi bi-check-circle-fill"></i>
                                    <span><strong>Save 15+ Hours Monthly:</strong> Automated approval workflows replace chaotic email chains and paper forms.</span>
                                </li>
                                <li>
                                    <i class="bi bi-check-circle-fill"></i>
                                    <span><strong>Payroll Integrity:</strong> Approved leaves and Loss of Pay (LOP) feed directly into payroll calculation.</span>
                                </li>
                                <li>
                                    <i class="bi bi-check-circle-fill"></i>
                                    <span><strong>Team Coverage:</strong> Real-time visibility into overlapping leaves keeps projects properly staffed.</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </section>

            <!-- STATS STRIP -->
            <section class="guide-stats-strip">
                <div class="guide-container">
                    <div class="guide-stats-grid">
                        <div class="guide-stat-box">
                            <div class="guide-stat-icon blue">
                                <i class="bi bi-pie-chart-fill"></i>
                            </div>
                            <div class="guide-stat-content">
                                <h3>100%</h3>
                                <p>Automated Balance Tracking</p>
                            </div>
                        </div>
                        <div class="guide-stat-box">
                            <div class="guide-stat-icon green">
                                <i class="bi bi-cash-stack"></i>
                            </div>
                            <div class="guide-stat-content">
                                <h3>Zero</h3>
                                <p>Payroll Deduction Errors</p>
                            </div>
                        </div>
                        <div class="guide-stat-box">
                            <div class="guide-stat-icon purple">
                                <i class="bi bi-lightning-charge-fill"></i>
                            </div>
                            <div class="guide-stat-content">
                                <h3>&lt; 2 Mins</h3>
                                <p>Average Request &amp; Approval Time</p>
                            </div>
                        </div>
                        <div class="guide-stat-box">
                            <div class="guide-stat-icon amber">
                                <i class="bi bi-file-earmark-check-fill"></i>
                            </div>
                            <div class="guide-stat-content">
                                <h3>Statutory</h3>
                                <p>Labor Law &amp; Policy Compliance</p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- SECTION 1: ESSENTIAL LEAVE TYPES DIRECTORY -->
            <section class="guide-section" id="leave-types">
                <div class="guide-container">
                    <div class="guide-section-header">
                        <span class="guide-tag blue">Policy Architecture</span>
                        <h2>Standard Employee <span class="text-blue">Leave Types &amp; Quotas</span></h2>
                        <p>A balanced leave policy balances company operational continuity with employee wellness, personal emergencies, and statutory rest entitlements.</p>
                    </div>

                    <div class="guide-grid-3">
                        <!-- Casual Leave -->
                        <div class="guide-card">
                            <div class="guide-card-icon blue">
                                <i class="bi bi-cup-hot-fill"></i>
                            </div>
                            <h3>Casual Leave (CL)</h3>
                            <p>Intended for personal errands, brief family commitments, or short unplanned personal breaks. Usually taken for 1 to 2 consecutive days.</p>
                            <span class="guide-card-pill blue"><i class="bi bi-calendar3"></i> 10 – 12 Days / Year</span>
                        </div>

                        <!-- Sick Leave -->
                        <div class="guide-card">
                            <div class="guide-card-icon rose">
                                <i class="bi bi-heart-pulse-fill"></i>
                            </div>
                            <h3>Sick &amp; Medical Leave (SL)</h3>
                            <p>Reserved for genuine illness, medical emergencies, or hospitalizations. Medical certificate is typically mandatory for consecutive leaves exceeding 3 days.</p>
                            <span class="guide-card-pill rose"><i class="bi bi-clipboard2-pulse"></i> 10 – 12 Days / Year</span>
                        </div>

                        <!-- Earned Leave -->
                        <div class="guide-card">
                            <div class="guide-card-icon green">
                                <i class="bi bi-airplane-fill"></i>
                            </div>
                            <h3>Earned / Privilege Leave (EL/PL)</h3>
                            <p>Accrued proportionally as employees complete working months. Planned vacations and extended travels. Eligible for annual carry-forward and encashment.</p>
                            <span class="guide-card-pill green"><i class="bi bi-star-fill"></i> 15 – 18 Days / Year</span>
                        </div>

                        <!-- Maternity & Paternity Leave -->
                        <div class="guide-card">
                            <div class="guide-card-icon purple">
                                <i class="bi bi-people-fill"></i>
                            </div>
                            <h3>Parental Leave (Maternity &amp; Paternity)</h3>
                            <p>Statutory protection for new parents. Governed by labor regulations (26 paid weeks for female employees, alongside 5–15 days paternity support).</p>
                            <span class="guide-card-pill purple"><i class="bi bi-award-fill"></i> Statutory Regulated</span>
                        </div>

                        <!-- Compensatory Off -->
                        <div class="guide-card">
                            <div class="guide-card-icon amber">
                                <i class="bi bi-clock-history"></i>
                            </div>
                            <h3>Compensatory Off (Comp-Off)</h3>
                            <p>Earned when an employee works on official company holidays, weekends, or emergency client duty. Can be availed within 30 to 60 days of accrual.</p>
                            <span class="guide-card-pill amber"><i class="bi bi-plus-circle"></i> On-Demand Accrual</span>
                        </div>

                        <!-- LOP / LWP -->
                        <div class="guide-card">
                            <div class="guide-card-icon teal">
                                <i class="bi bi-wallet2"></i>
                            </div>
                            <h3>Loss of Pay (LOP / LWP)</h3>
                            <p>Applied when an employee exceeds their allowed paid leave quota or takes unauthorized absence. Automatically deducted proportionally in monthly payroll.</p>
                            <span class="guide-card-pill blue"><i class="bi bi-currency-dollar"></i> Unpaid Salary Deduction</span>
                        </div>
                    </div>
                </div>
            </section>

            <!-- SECTION 2: END-TO-END WORKFLOW PIPELINE -->
            <section class="guide-section alt-bg">
                <div class="guide-container">
                    <div class="guide-section-header">
                        <span class="guide-tag blue">Seamless Process</span>
                        <h2>The 5-Step <span class="text-blue">Leave Lifecycle Workflow</span></h2>
                        <p>How an automated HRMS streamlines the journey from an employee’s initial leave request to payroll closure with zero manual friction.</p>
                    </div>

                    <div class="guide-workflow-track">
                        <div class="guide-step-card">
                            <div class="guide-step-badge">1</div>
                            <h4>Balance Check</h4>
                            <p>Employee views available leave quota in the self-service portal before submitting request.</p>
                        </div>
                        <div class="guide-step-card">
                            <div class="guide-step-badge">2</div>
                            <h4>Digital Submission</h4>
                            <p>Selects leave dates, category (CL, SL, PL), and provides reason in a simple web form.</p>
                        </div>
                        <div class="guide-step-card">
                            <div class="guide-step-badge">3</div>
                            <h4>Conflict Detection</h4>
                            <p>System automatically checks team schedule to ensure no critical department shortfalls.</p>
                        </div>
                        <div class="guide-step-card">
                            <div class="guide-step-badge">4</div>
                            <h4>One-Click HR Review</h4>
                            <p>HR or reporting manager reviews request on dashboard and approves or rejects with reason.</p>
                        </div>
                        <div class="guide-step-card">
                            <div class="guide-step-badge">5</div>
                            <h4>Payroll &amp; Time Sync</h4>
                            <p>Approved leaves populate attendance register and sync automatically with monthly salary slips.</p>
                        </div>
                    </div>
                </div>
