                var iconContainer = document.getElementById('modalIcon');
                iconContainer.className = 'hrhelp-modal-icon ' + data.iconClass;
                iconContainer.innerHTML = '<i class="bi ' + data.icon + '"></i>';

                document.getElementById('modalContent').innerHTML = data.content;

                var overlay = document.getElementById('helpModalOverlay');
                overlay.classList.add('show');
                document.body.style.overflow = 'hidden';
            }

            function closeHelpModal(e) {
                if (e && e.target && e.target !== document.getElementById('helpModalOverlay')) {
                    // clicked inside dialog
                    return;
                }
                var overlay = document.getElementById('helpModalOverlay');
                overlay.classList.remove('show');
                document.body.style.overflow = '';
            }

