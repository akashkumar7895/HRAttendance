@model HRAttendanceMVC.Application.DTOs.SignupDto

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Signup - HR Attendance Management</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f8f9fa;
        }

        /* LEFT BRAND SECTION */
        .brand-section {
            background: linear-gradient(135deg, #7b02a8 0%, #9602cb 50%, #ba2be0 100%);
            color: #ffffff;
        }

        .feature-icon {
            width: 42px;
            height: 42px;
            background: rgba(255, 255, 255, 0.15);
            border-radius: 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
        }

        /* ================= INPUT BOX ================= */

        .input-group {
            width: 100%;
            border: 1px solid #dee2e6;
            border-radius: 8px !important;
            overflow: hidden;
            background-color: #ffffff;
            transition: all 0.2s ease;
        }

            /* Full purple border on focus */
            .input-group:focus-within {
                border-color: #9602cb;
                box-shadow: 0 0 0 0.25rem rgba(150, 2, 203, 0.15);
            }

            /* Icon */
            .input-group .input-group-text {
                border: 0 !important;
                border-radius: 0 !important;
                background-color: #f8f9fa;
                color: #6c757d;
            }

            /* Input */
            .input-group .form-control {
                border: 0 !important;
                border-radius: 0 !important;
                box-shadow: none !important;
                outline: none;
            }

                .input-group .form-control:focus {
                    border: 0 !important;
                    box-shadow: none !important;
                    outline: none;
                }

            /* Password Eye Button */
            .input-group .btn {
                border: 0 !important;
                border-radius: 0 !important;
                background-color: #f8f9fa;
                color: #6c757d;
                box-shadow: none !important;
            }

                .input-group .btn:hover {
                    background-color: #e9ecef;
                    color: #9602cb;
                }

        /* ================= PURPLE BUTTON ================= */

        .btn-purple {
            background-color: #9602cb;
            border: 1px solid #9602cb;
            border-radius: 8px;
            transition: all 0.3s ease;
        }

            .btn-purple:hover {
                background-color: #7b02a8;
                border-color: #7b02a8;
                transform: translateY(-1px);
            }

        /* ================= LINK ================= */

        .custom-link {
            color: #9602cb;
            font-weight: 600;
        }

            .custom-link:hover {
                color: #7b02a8;
                text-decoration: underline !important;
            }

        /* ================= HR ROLE BOX ================= */

        .hr-role-box {
            width: 100%;
            background-color: #f8f9fa;
            border: 1px solid #dee2e6;
            border-radius: 8px;
            padding: 12px;
            box-sizing: border-box;
        }

        /* ================= ROLE SELECTION ================= */

        .role-option {
            min-height: 75px;
            border: 1px solid #dee2e6;
            border-radius: 10px;
            padding: 12px;
            display: flex;
            align-items: center;
            gap: 10px;
            cursor: pointer;
            background-color: #ffffff;
            transition: all 0.2s ease;
        }

            .role-option i {
                font-size: 1.4rem;
                color: #6c757d;
            }

            .role-option strong {
                display: block;
                color: #212529;
            }

            .role-option small {
                display: block;
                color: #6c757d;
                font-size: 12px;
            }

            .role-option:hover {
                border-color: #9602cb;
                background-color: #faf5fc;
            }

        .btn-check:checked + .role-option {
            border-color: #9602cb;
            background-color: #f8edfc;
            box-shadow: 0 0 0 2px rgba(150, 2, 203, 0.12);
        }

            .btn-check:checked + .role-option i {
                color: #9602cb;
            }

    </style>
    

</head>

<body>

    <div class="container-fluid p-0 vh-100 overflow-hidden">

        <div class="row g-0 h-100">

            <!-- LEFT SIDE -->
            <div class="col-lg-6 d-none d-lg-flex brand-section p-5 flex-column justify-content-between">

                <!-- Logo -->
                <div class="d-flex align-items-center gap-2">

                    <i class="bi bi-people-fill fs-3"></i>

                    <span class="fs-4 fw-bold">
                        HR Attendance Portal
                    </span>

                </div>

                <!-- Middle -->
                <div class="my-auto pe-lg-5">

                    <h1 class="display-5 fw-bold mb-3">
                        Join Our HR Portal!
                    </h1>

                    <p class="fs-5 opacity-75 mb-4">
                        Create an HR account to manage workforce data,
                        leave approvals, and employee records efficiently.
                    </p>

                    <!-- Feature 1 -->
                    <div class="d-flex flex-column gap-3">

                        <div class="d-flex align-items-center gap-3">

                            <div class="feature-icon flex-shrink-0">

                                <i class="bi bi-person-check-fill"></i>

                            </div>

                            <div>

                                <h6 class="mb-0 fw-bold">
                                    Easy Onboarding
                                </h6>

                                <small class="opacity-75">
                                    Get setup and start managing team data in minutes.
                                </small>

                            </div>

                        </div>

                        <!-- Feature 2 -->
                        <div class="d-flex align-items-center gap-3">

                            <div class="feature-icon flex-shrink-0">

                                <i class="bi bi-person-gear"></i>

                            </div>

                            <div>

                                <h6 class="mb-0 fw-bold">
                                    HR Management
                                </h6>

                                <small class="opacity-75">
                                    Manage attendance, employees and leave requests.
                                </small>

                            </div>

                        </div>

                        <!-- Feature 3 -->
                        <div class="d-flex align-items-center gap-3">

                            <div class="feature-icon flex-shrink-0">

                                <i class="bi bi-shield-lock-fill"></i>

                            </div>

                            <div>

                                <h6 class="mb-0 fw-bold">
                                    Secure Access
                                </h6>

                                <small class="opacity-75">
                                    Role-based access keeps your organization secure.
                                </small>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- Footer -->
                <div class="small opacity-50">

                    &copy; @DateTime.Now.Year
                    HR Attendance System.
                    All rights reserved.

                </div>

            </div>

            <!-- RIGHT SIDE -->
            <div class="col-lg-6 d-flex align-items-center justify-content-center bg-white p-4 p-sm-5 overflow-y-auto">

                <div class="w-100" style="max-width: 420px;">

                    <!-- Heading -->
                    <div class="text-center text-lg-start mb-4">

                        <h2 class="fw-bold text-dark mb-1">
                            Create HR Account
                        </h2>

                        <p class="text-muted">
                            Fill in your details to register
                        </p>

                    </div>

                    <!-- FORM -->
                    <form asp-action="Signup"
                          asp-controller="Account"
                          method="post">

                        @Html.AntiForgeryToken()

                        <!-- Validation -->
                        <div asp-validation-summary="ModelOnly"
                             class="text-danger small mb-3">
                        </div>

                        <!-- NAME -->
                        <div class="mb-3">

                            <label class="form-label fw-semibold text-secondary">
                                Full Name
                            </label>

                            <div class="input-group">

                                <span class="input-group-text bg-light text-muted border-end-0">

                                    <i class="bi bi-person"></i>

                                </span>

                                <input asp-for="Name"
                                       class="form-control border-start-1 ps-1"
                                       placeholder="John Doe"
                                       required />

                            </div>

                            <span asp-validation-for="Name"
                                  class="text-danger small">
                            </span>

                        </div>

                        <!-- EMAIL -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-secondary">
                                Email Address
                            </label>

                            <div class="input-group">

                                <span class="input-group-text bg-light text-muted border-end-0">

                                    <i class="bi bi-envelope"></i>

                                </span>

                                <input asp-for="Email"
                                       type="email"
                                       class="form-control border-start-0 ps-0"
                                       placeholder="name@company.com"
                                       required />

                            </div>

                            <span asp-validation-for="Email"
                                  class="text-danger small">
                            </span>
                        </div>

                        
                        <!-- PASSWORD -->
                        <div class="mb-3">

                            <label class="form-label fw-semibold text-secondary">
                                Password
                            </label>

                            <div class="input-group">

                                <span class="input-group-text bg-light text-muted border-end-0">
                                    <i class="bi bi-lock"></i>
                                </span>

                                <input asp-for="Password"
                                       type="password"
                                       id="passwordInput"
                                       class="form-control border-start-0 border-end-0 ps-0"
                                       placeholder="••••••••"
                                       required />

                                <button type="button"
                                        class="btn btn-light border border-start-0"
                                        id="togglePassword"
                                        tabindex="-1">
                                    <i class="bi bi-eye" id="togglePasswordIcon"></i>
                                </button>

                            </div>

                            <span asp-validation-for="Password"
                                  class="text-danger small">
                            </span>

                        </div>

                        <!-- ROLE INFORMATION -->
                        @* <div class="mb-3"> *@

                        @*     <label class="form-label fw-semibold text-secondary"> *@
                        @*         Account Role *@
                        @*     </label> *@

                        @*     <div class="hr-role-box"> *@

                        @*         <div class="d-flex align-items-center"> *@

                        @*             <i class="bi bi-person-badge-fill text-secondary me-2"></i> *@

                        @*             <strong>HR</strong> *@

                        @*         </div> *@

                        @*         <small class="text-muted"> *@
                        @*             Public registration creates HR accounts only. *@
                        @*         </small> *@

                        @*     </div> *@

                        @* </div> *@

                        <!-- ACCOUNT ROLE -->
                        <div class="mb-3">

                            <label class="form-label fw-semibold text-secondary">
                                Account Role
                            </label>

                            <div class="row g-2">

                                <!-- HR ROLE -->
                                <div class="col-6">

                                    <input type="radio"
                                           class="btn-check"
                                           asp-for="Role"
                                           value="HR"
                                           id="roleHR"
                                           autocomplete="off"
                                           checked />

                                    <label class="role-option w-100"
                                           for="roleHR">

                                        <i class="bi bi-person-badge-fill"></i>

                                        <div>
                                            <strong>HR</strong>

                                            <small>
                                                Manage employees & HR
                                            </small>
                                        </div>

                                    </label>

                                </div>


                                <!-- EMPLOYEE ROLE -->
                                <div class="col-6">

                                    <input type="radio"
                                           class="btn-check"
                                           asp-for="Role"
                                           value="Employee"
                                           id="roleEmployee"
                                           autocomplete="off" />

                                    <label class="role-option w-100"
                                           for="roleEmployee">

                                        <i class="bi bi-person-fill"></i>

                                        <div>
                                            <strong>Employee</strong>

                                            <small>
                                                Employee self-service
                                            </small>
                                        </div>

                                    </label>

                                </div>

                            </div>

                            <span asp-validation-for="Role"
                                  class="text-danger small">
                            </span>

                        </div>

                        <!-- ADMIN INFORMATION -->
                        <div class="alert alert-info small">

                            <i class="bi bi-info-circle-fill me-2"></i>

                            <strong>Note:</strong>

                            Only one Admin account is allowed
                            in the system. Admin accounts cannot
                            be created through public signup.

                        </div>

                        <!-- REGISTER -->
                        <button type="submit"
                                class="btn btn-purple text-white w-100 fw-bold py-2 mt-2 shadow-sm">

                            <i class="bi bi-person-plus-fill me-1"></i>

                            Register HR Account

                        </button>

                    </form>
                    <!-- LOGIN -->
                    <div class="text-center mt-4 pt-2 border-top">

                        <span class="text-muted small">
                            Already have an account?
                        </span>

                        <a asp-action="Login"
                           asp-controller="Account"
                           class="custom-link text-decoration-none ms-1">

                            Login

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>
    <script>
        document.getElementById("togglePassword").addEventListener("click", function () {

            const passwordInput = document.getElementById("passwordInput");
            const passwordIcon = document.getElementById("togglePasswordIcon");

            if (passwordInput.type === "password") {
                passwordInput.type = "text";

                passwordIcon.classList.remove("bi-eye");
                passwordIcon.classList.add("bi-eye-slash");
            }
            else {
                passwordInput.type = "password";

                passwordIcon.classList.remove("bi-eye-slash");
                passwordIcon.classList.add("bi-eye");
            }
        });
    </script>
</body>
</html>