            </div>

            <!-- Box 6: Parichay Webinars (Yellow Tint) -->
            <div class="eco-card eco-yellow">
                <div class="eco-img-box">
                    <i class="fa-solid fa-display eco-icon"></i>
                </div>
                <h3>Parichay Webinars</h3>
                <p>Live sessions on statutory updates, budget impact, and evolving labour codes � with Q&A</p>
                <a href="#" class="know-more">Know More</a>
            </div>

        </div>

    </section>

</div>

@section Scripts {
    <script src="~/js/punch-station.js" asp-append-version="true"></script>
    <script>
        function playNavosVideo(event) {
            if (event) {
                if (event.target.closest('.quick-command')) return;
            }
            const defaultView = document.getElementById('navosDefaultView');
            const playerWrap = document.getElementById('navosVideoPlayerWrap');
            const iframe = document.getElementById('navosHrmsIframe');
            const navosCard = document.getElementById('navosCard');

            if (defaultView && playerWrap && iframe) {
                defaultView.style.display = 'none';
                playerWrap.style.display = 'flex';
                if (navosCard) {
                    navosCard.classList.add('playing-video');
                }
                iframe.src = 'https://www.youtube.com/embed/uu-j7zXGEPA?autoplay=1&rel=0&modestbranding=1';
            }
        }

        function closeNavosVideo(event) {
            if (event) {
                event.stopPropagation();
            }
            const defaultView = document.getElementById('navosDefaultView');
            const playerWrap = document.getElementById('navosVideoPlayerWrap');
            const iframe = document.getElementById('navosHrmsIframe');
            const navosCard = document.getElementById('navosCard');

            if (iframe) {
                iframe.src = '';
            }
            if (playerWrap) {
                playerWrap.style.display = 'none';
            }
            if (navosCard) {
                navosCard.classList.remove('playing-video');
            }
            if (defaultView) {
                defaultView.style.display = 'flex';
            }
        }
    </script>
}
