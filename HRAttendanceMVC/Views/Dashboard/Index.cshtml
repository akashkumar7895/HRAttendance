@{
    ViewData["Title"] = "Dashboard";
}

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

<link rel="stylesheet" href="~/css/dashboard.css" />

<div class="dashboard-page">

    <!-- =========================
    HERO SECTION
    ========================== -->
    <section class="hero-section">

        <div class="small-label">
            HR ATTENDANCE
        </div>

        <h1>
            Smart <span>AI</span> for Operations. Real Human Leadership for <span>Growth</span>.
        </h1>

        <p class="hero-description">
            Plan, Recruit, Onboard, Pay, Manage, Upskill, Appraise and
            Empower your people all in one platform.
        </p>


        <!-- =========================
        STATISTICS
        ========================== -->
        <div class="stats-container" >

            <!-- Active Employees -->
            <div class="stat-box stat-green">

                <div class="stat-icon">
                    <i class="fa-solid fa-users"></i>
                </div>

                <div>
                    <h3>@ViewBag.Employees</h3>
                    <p>Active Employees</p>
                </div>

            </div>


            <!-- Today Present -->
            <div class="stat-box stat-blue">

                <div class="stat-icon">
                    <i class="fa-solid fa-user-check"></i>
                </div>

                <div>
                    <h3>@ViewBag.TodayPresent</h3>
                    <p>Today Present</p>
                </div>

            </div>
            <!-- Today Absent -->
            <div class="stat-box stat-red">

                <div class="stat-icon">
                    <i class="fa-solid fa-user-xmark"></i>
                </div>

                <div>
                    <h3>@ViewBag.TodayAbsent</h3>
                    <p>Today Absent</p>
                </div>

            </div>

            <!-- Pending Leaves -->
            <div class="stat-box stat-yellow">

                <div class="stat-icon">
                    <i class="fa-solid fa-calendar-days"></i>
                </div>

                <div>
                    <h3>@ViewBag.PendingLeaves</h3>
                    <p>Pending Leaves</p>
                </div>

            </div>


            <!-- Leave Types -->
            <div class="stat-box stat-purple">

                <div class="stat-icon">
                    <i class="fa-solid fa-file-lines"></i>
                </div>

                <div>
                    <h3>@ViewBag.TotalLeaveTypes</h3>
                    <p>Leave Types</p>
                </div>

            </div>

        </div>



        <!-- =========================
        ACTION BUTTONS
        ========================== -->
        @if (User.IsInRole("HR") || User.IsInRole("Employee"))
        {
            <div class="action-buttons">

                @if (User.IsInRole("HR"))
                {
                    <a asp-controller="Employee"
                       asp-action="Create"
                       class="primary-action">

                        <i class="fa-solid fa-user-plus"></i>
                        Add Employee

                    </a>
                }


                <a asp-controller="Attendance"
                   asp-action="Create"
                   class="secondary-action">

                    <i class="fa-solid fa-user-check"></i>
                    Mark Attendance

                </a>




                <a asp-controller="LeaveRequest"
                   asp-action="Create"
                   class="secondary-action">

                    <i class="fa-solid fa-calendar-plus"></i>
                    Create Leave

                </a>

            </div>
        }
        

    
    <!-- ==============================================================
         1-CLICK PUNCH IN / PUNCH OUT & LIVE TIMER CARD (EMPLOYEE)
    ============================================================== -->
    @{
        var empDto = ViewBag.EmployeeData as HRAttendanceMVC.Application.DTOs.EmployeeDashboardDto;
    }

    @if (empDto != null && empDto.IsFound)
    {
        <section class="punch-widget-section mb-4" id="punchWidgetStation" data-punched-in="@(empDto.IsPunchedIn ? "true" : "false")" data-punched-out="@(empDto.IsPunchedOut ? "true" : "false")" data-checkin-raw="@(empDto.TodayCheckInTime?.ToString(@"hh\:mm\:ss") ?? "")" data-checkout-raw="@(empDto.TodayCheckOutTime?.ToString(@"hh\:mm\:ss") ?? "")">
            <div class="punch-card shadow-sm border-0">
                <div class="punch-card-header d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="avatar-circle">
                            <i class="fa-solid fa-user-clock fs-4 text-purple"></i>
                        </div>
                        <div>
                            <h4 class="mb-0 fw-bold">Daily Attendance &amp; Punch Station</h4>
                            <p class="text-muted mb-0 small">
                                Hello, <span class="fw-semibold text-dark">@(empDto.Employee?.FullName ?? User.Identity?.Name)</span> 
                                &bull; <span class="badge bg-light text-dark border">@(empDto.Employee?.Designation ?? "Employee")</span> 
                                <span class="badge bg-light text-secondary border">@(empDto.Employee?.Department ?? "General")</span>
                            </p>
                        </div>
                    </div>

                    <div class="header-clock-pill d-flex align-items-center gap-2">
                        <i class="fa-regular fa-calendar-check text-purple"></i>
                        <span id="liveCurrentDate" class="fw-semibold text-secondary">--</span>
                        <span class="clock-divider">|</span>
                        <i class="fa-regular fa-clock text-purple"></i>
                        <span id="liveDigitalClock" class="fw-bold fs-6 text-dark font-monospace">--:--:--</span>
                    </div>
                </div>

                <div class="punch-card-body p-4">
                    <div class="row g-4 align-items-center">
                        
                        <!-- 3 Stat Tiles -->
                        <div class="col-lg-7 col-md-12">
                            <div class="row g-3">
                                <!-- Punch In -->
                                <div class="col-sm-4">
                                    <div class="punch-stat-tile punch-stat-in">
                                        <div class="tile-icon">
                                            <i class="fa-solid fa-arrow-right-to-bracket"></i>
                                        </div>
                                        <div class="tile-content">
                                            <span class="tile-label">Punch In</span>
                                            <h4 id="punchInDisplay" class="tile-value mb-0">
                                                @(string.IsNullOrEmpty(empDto.TodayCheckIn) ? "--:--" : empDto.TodayCheckIn)
                                            </h4>
                                            <span class="tile-sub text-muted">Arrival Time</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Live Stopwatch / Active Duration -->
                                <div class="col-sm-4">
                                    <div class="punch-stat-tile punch-stat-timer @(empDto.IsPunchedIn && !empDto.IsPunchedOut ? "active-glow" : "")" id="punchTimerTile">
                                        <div class="tile-icon">
                                            <i class="fa-solid fa-stopwatch @(empDto.IsPunchedIn && !empDto.IsPunchedOut ? "fa-spin" : "")" id="stopwatchIcon"></i>
                                        </div>
                                        <div class="tile-content">
                                            <span class="tile-label">Live Work Timer</span>
                                            <h4 id="punchLiveTimerDisplay" class="tile-value mb-0 font-monospace text-primary">
                                                @(string.IsNullOrEmpty(empDto.FormattedWorkingDuration) ? "00h 00m 00s" : empDto.FormattedWorkingDuration)
                                            </h4>
                                            <span id="punchTimerSub" class="tile-sub text-muted">
                                                @(empDto.IsPunchedOut ? "Shift Completed" : (empDto.IsPunchedIn ? "Active Working" : "Not Started"))
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Punch Out -->
                                <div class="col-sm-4">
                                    <div class="punch-stat-tile punch-stat-out">
                                        <div class="tile-icon">
                                            <i class="fa-solid fa-arrow-right-from-bracket"></i>
                                        </div>
                                        <div class="tile-content">
                                            <span class="tile-label">Punch Out</span>
                                            <h4 id="punchOutDisplay" class="tile-value mb-0">
                                                @(string.IsNullOrEmpty(empDto.TodayCheckOut) ? "--:--" : empDto.TodayCheckOut)
                                            </h4>
                                            <span class="tile-sub text-muted">Departure Time</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Status Badge & Remarks -->
                            <div class="mt-3 d-flex flex-wrap align-items-center gap-2">
                                <span class="small text-muted fw-semibold">Today's Status:</span>
                                <span id="punchStatusBadge" class="badge rounded-pill px-3 py-2 fs-7 
                                    @(empDto.IsPunchedOut ? "bg-info text-dark" : (empDto.IsPunchedIn ? "bg-success text-white" : "bg-secondary text-white"))">
                                    <i id="punchStatusIcon" class="fa-solid @(empDto.IsPunchedOut ? "fa-circle-check" : (empDto.IsPunchedIn ? "fa-circle-play" : "fa-circle-dot")) me-1"></i>
                                    <span id="punchStatusText">
                                        @(empDto.IsPunchedOut ? "Completed for Today" : (empDto.IsPunchedIn ? "Punched In / Working" : "Not Punched In"))
                                    </span>
                                </span>

                                @if (!string.IsNullOrEmpty(empDto.Remarks))
                                {
                                    <span id="existingRemarksBadge" class="badge bg-light text-secondary border px-2 py-1 small">
                                        <i class="fa-regular fa-comment-dots me-1"></i> <span id="remarksText">@empDto.Remarks</span>
                                    </span>
                                }
                                else
                                {
                                    <span id="existingRemarksBadge" class="badge bg-light text-secondary border px-2 py-1 small" style="display:none;">
                                        <i class="fa-regular fa-comment-dots me-1"></i> <span id="remarksText"></span>
                                    </span>
                                }
                            </div>
                        </div>

                        <!-- Action Area -->
                        <div class="col-lg-5 col-md-12">
                            <div class="punch-action-box p-3 rounded-4 bg-light border">
                                <div class="mb-2">
                                    <label for="punchRemarks" class="form-label small fw-semibold text-secondary mb-1">
                                        <i class="fa-solid fa-location-dot me-1 text-purple"></i> Work Mode / Note:
                                    </label>
                                    <select id="punchRemarks" class="form-select form-select-sm">
                                        <option value="Working from Office">ðŸ¢ Working from Office</option>
                                        <option value="Work From Home (WFH)">ðŸ  Work From Home (WFH)</option>
                                        <option value="Client Site / Field Visit">ðŸš— Client Site / Field Visit</option>
                                        <option value="Half Day Shift">â±ï¸ Half Day Shift</option>
                                    </select>
                                </div>

                                <form id="punchForm" method="post">
                                    @Html.AntiForgeryToken()
                                    <div class="d-grid gap-2">
                                        <!-- Punch In Button -->
                                        <button type="button" 
                                                id="btnPunchIn" 
                                                class="btn btn-punch-in btn-lg fw-bold shadow-sm"
                                                style="@(empDto.IsPunchedIn ? "display:none;" : "")">
                                            <i class="fa-solid fa-fingerprint fs-4 me-2"></i> 1-Click Punch In
                                        </button>

                                        <!-- Punch Out Button -->
                                        <button type="button" 
                                                id="btnPunchOut" 
                                                class="btn btn-punch-out btn-lg fw-bold shadow-sm"
                                                style="@(!empDto.IsPunchedIn || empDto.IsPunchedOut ? "display:none;" : "")">
                                            <i class="fa-solid fa-right-from-bracket fs-4 me-2"></i> Punch Out &amp; Finish
                                        </button>

                                        <!-- Shift Finished Alert -->
                                        <div id="punchCompletedBanner" 
                                             class="alert alert-success d-flex align-items-center mb-0 py-2 px-3 small rounded-3"
                                             style="@(!empDto.IsPunchedOut ? "display:none !important;" : "")">
                                            <i class="fa-solid fa-circle-check fs-4 text-success me-2"></i>
                                            <div>
                                                <strong>Shift Completed!</strong> Great job today. Have a restful evening!
                                            </div>
                                        </div>
                                    </div>
                                </form>

                                <div class="d-flex justify-content-between align-items-center mt-2 px-1">
                                    <span class="text-muted x-small">
                                        <i class="fa-solid fa-shield-halved text-success me-1"></i> Real-time server sync
                                    </span>
                                    <a asp-controller="Attendance" asp-action="Index" class="x-small text-decoration-none fw-semibold text-purple">
                                        My Attendance History &rarr;
                                    </a>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </section>
    }
    else if (User.IsInRole("Employee"))
    {
        <div class="alert alert-warning mt-4 mx-auto text-start" style="max-width: 900px; border-radius: 14px;">
            <div class="d-flex align-items-center">
                <i class="fa-solid fa-triangle-exclamation fs-4 me-3 text-warning"></i>
                <div>
                    <strong>Employee Record Not Linked:</strong>
                    <p class="mb-0 small text-muted">Your logged in account is not yet connected with an employee profile. Please ask HR to add your employee record with your email address.</p>
                </div>
            </div>
        </div>
    }
</section>



    <!-- =========================
         NAVOS SECTION
    ========================== -->
    <section class="navos-card" id="navosCard">

        <!-- 1. DEFAULT VIEW (EXACTLY AS SHOWN IN SCREENSHOT WITH CENTER PLAY BUTTON) -->
        <div class="navos-content-wrap" id="navosDefaultView" onclick="playNavosVideo(event)">

            <!-- =========================
                 LEFT COLUMN
            ========================== -->
            <div class="navos-left">

                <div class="navos-logo">
                    <span>HR</span>
                </div>

                <h2>
                    NAV<span>igate.</span><br />
                    O<span>perate.</span><br />
                    S<span>upport.</span>
                </h2>


                <a href="@Url.Action("Index", "Attendance")" class="quick-command text-decoration-none text-dark" onclick="event.stopPropagation()">
                    <span>
                        <i class="fa-solid fa-terminal"></i>
                    </span>
                    <strong>View today's attendance</strong>
                </a>

                <a href="@Url.Action("Index", "Attendance")" class="quick-command text-decoration-none text-dark" onclick="event.stopPropagation()">
                    <span>
                        <i class="fa-solid fa-terminal"></i>
                    </span>
                    <strong>Generate attendance report</strong>
                </a>

                <a href="@Url.Action("Index", "LeaveRequest")" class="quick-command text-decoration-none text-dark" onclick="event.stopPropagation()">
                    <span>
                        <i class="fa-solid fa-terminal"></i>
                    </span>
                    <strong>Check pending leaves</strong>
                </a>

            </div>

            <!-- =========================
                 CENTER PLAY BUTTON
            ========================== -->
            <div class="navos-center-play-box" title="Click to Watch Human Resource Management System Video">
                <button type="button" class="navos-center-play-btn" onclick="playNavosVideo(event)">
                    <i class="fa-solid fa-play"></i>
                </button>
            </div>

            <!-- =========================
                 RIGHT: CHAT WINDOW
            ========================== -->
            <div class="navos-right">

                <div class="chat-window navos-clickable-chat" onclick="playNavosVideo(event)" title="Click to Watch Human Resource Management System Video">

                    <div class="chat-header">
                        <span>
                            <i class="fa-solid fa-robot"></i>
                            HR Assistant
                        </span>

                        <span class="chat-header-diamonds">
                            <i class="fa-solid fa-diamond"></i>
                            <i class="fa-solid fa-diamond"></i>
                            <i class="fa-solid fa-diamond"></i>
                        </span>
                    </div>

                    <div class="chat-body">

                        <div class="bot-message">
                            Hi, how can I help you today?
                        </div>

                        <div class="user-message">
                            Show today's attendance
                        </div>

                        <div class="bot-message">
                            Today's attendance report is ready.
                            You can view it from the Attendance section.
                        </div>

                    </div>

                    <div class="chat-input">

                        <span>
                            <i class="fa-solid fa-paperclip"></i>
                        </span>

                        <span class="placeholder">
                            Please type your query
                        </span>

                        <button type="button">
                            <i class="fa-solid fa-paper-plane"></i>
                        </button>

                    </div>

                </div>

            </div>

        </div>

        <!-- 2. IN-PLACE VIDEO PLAYER (RUNS DIRECTLY IN THIS CARD ON THIS PAGE) -->
        <div class="navos-video-player-wrap" id="navosVideoPlayerWrap" style="display: none;">

            <div class="navos-video-player-header">
                <div class="d-flex align-items-center gap-2">
                    <span class="video-live-pill">
                        <span class="video-pulse-dot"></span>
                        <i class="fa-solid fa-play"></i> PLAYING
                    </span>
                    <strong class="text-white navos-video-title">Human Resource Management System (HRMS)</strong>
                </div>

                <button type="button" class="btn-navos-close-video" onclick="closeNavosVideo(event)" title="Close Video & Return to Assistant">
                    <i class="fa-solid fa-xmark me-1"></i> Close Video
                </button>
            </div>

            <div class="navos-video-iframe-container">
                <iframe id="navosHrmsIframe"
                        src=""
                        title="Human Resource Management System Video"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        allowfullscreen></iframe>
            </div>

            <div class="navos-video-player-footer">
                <span class="text-white-50 small">
                    <i class="fa-solid fa-circle-info text-info me-1"></i>
                    HRMS Overview: Attendance, Leave &amp; Payroll Management System
                </span>

                <button type="button" class="btn btn-sm btn-outline-light rounded-pill px-3 py-1" onclick="closeNavosVideo(event)">
                    <i class="fa-solid fa-arrow-left me-1"></i> Back to HR Assistant
                </button>
            </div>

        </div>

    </section>
    <!-- =========================
         QUICK ACTIONS
    ========================== -->
    @if (User.IsInRole("HR") || User.IsInRole("Employee"))
    {
        <section class="quick-section">

            <h2>Quick Actions</h2>

            <div class="quick-grid">


                <!-- Add Employee -->
                @if (User.IsInRole("HR"))
                {
                    <a asp-controller="Employee"
                       asp-action="Create"
                       class="quick-card">

                        <div class="quick-card-icon">
                            <i class="fa-solid fa-user-plus"></i>
                        </div>

                        <div>
                            <h4>Add Employee</h4>
                            <p>Create a new employee record</p>
                        </div>

                    </a>
                }


                <!-- Mark Attendance --> 
                <a asp-controller="Attendance"
                   asp-action="Create"
                   class="quick-card">

                    <div class="quick-card-icon">
                        <i class="fa-solid fa-calendar-check"></i>
                    </div>

                    <div>
                        <h4>Mark Attendance</h4>
                        <p>Record employee attendance</p>
                    </div>

                </a>


                <!-- Create Leave -->
                <a asp-controller="LeaveRequest"
                   asp-action="Create"
                   class="quick-card">

                    <div class="quick-card-icon">
                        <i class="fa-solid fa-calendar-plus"></i>
                    </div>

                    <div>
                        <h4>Create Leave</h4>
                        <p>Submit a new leave request</p>
                    </div>

                </a>

            </div>

        </section>
    }


   
    <section class="image-features-section">

        <div class="image-features-header">
            <h2>What makes <span>33,000+ companies</span> back HR</h2>
            <p>Whether you're replacing spreadsheets or outgrowing your current HRMS, here's what changes on day one.</p>
        </div>

